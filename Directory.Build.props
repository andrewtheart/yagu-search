<Project>
  <PropertyGroup>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!--
      Structured logging via Microsoft.Extensions.Logging ILogger: we intentionally use plain
      LogInformation/LogWarning/... off the hot path and reserve source-generated [LoggerMessage]
      for the performance-critical paths only. Suppress the analyzers that would otherwise flag
      EVERY plain structured call across the ~800 log sites: CA1848 ("use the LoggerMessage
      delegates") and CA1873 ("avoid potentially expensive logging" — argument evaluation is
      acceptable off the hot path). (Matches the pre-existing suppression in Yagu.TelemetryFunction.)
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <!--
    Vendored third-party projects (under vendor/) are multi-targeting class libraries, not deployable
    apps. Mark them non-publishable so a bare 'dotnet publish' at the solution root skips them instead
    of failing with NETSDK1129 ("Publish not supported without specifying a target framework") on their
    <TargetFrameworks>. They are still built and copied as dependencies of the Yagu app, so
    'dotnet publish src/Yagu/Yagu.csproj' is unaffected. (Note: src/vendor/PaddleSharp has its own gitignored
    Directory.Build.props that shadows this file and sets the same property; this covers fresh clones
    and any vendored project without a local shadow props.)
  -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('vendor'))">
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
</Project>
