  <!-- Copy the Rust cdylib next to the test assembly so the native fast-path
       is exercised under `dotnet test`. The build is gated on Cargo.toml
       existing; missing DLLs fall back to the managed path. -->
  <Target Name="BuildYaguCoreForTests"
          BeforeTargets="BeforeBuild"
          Condition="'$(BuildRustCore)' == 'true' And Exists('$(RustCoreDir)Cargo.toml')">
    <Exec Command="&quot;$(CargoExe)&quot; build $(RustCargoProfileArgs) $(RustCargoFeatureArgs) --quiet"
          WorkingDirectory="$(RustCoreDir)"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          ContinueOnError="WarnAndContinue" />
    <Warning Condition="!Exists('$(RustDllPath)')"
             Text="yagu-core: Rust build did not produce $(RustDllPath); native-path tests will fail." />
    <ItemGroup>
      <_YaguCoreTestRuntimeFiles Include="$(RustDllPath)" Condition="Exists('$(RustDllPath)')" />
      <_YaguCoreTestRuntimeFiles Include="$(RustPdbPath)" Condition="Exists('$(RustPdbPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_YaguCoreTestRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_YaguCoreTestRuntimeFiles)' != ''" />
  </Target>

  <ItemGroup Condition="Exists('$(RustDllPath)')">
    <None Include="$(RustDllPath)">
      <Link>yagu_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(RustPdbPath)')">
    <None Include="$(RustPdbPath)">
      <Link>yagu_core.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yagu.FakeIndexWorker\Yagu.FakeIndexWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Yagu.IndexWorker\Yagu.IndexWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\vendor\SharpSevenZip\SharpSevenZip\SharpSevenZip\SharpSevenZip.csproj" />
    <!-- SemanticPlanApplier (compiled into the test assembly) now uses vendored nChronic for
         natural-language date parsing, so the tests need the same reference. -->
    <ProjectReference Include="..\..\src\vendor\nChronic\Chronic\Chronic.csproj" />
  </ItemGroup>

</Project>
