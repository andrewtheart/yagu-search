<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Yagu.IndexWorker is the OUT-OF-PROCESS host for the native content-index engine.

    Why it exists:
      All index parsing / memory-mapping / native trigram querying (yagu_core.dll's `index` module) runs
      here, isolated from the main app. A read-time fault or native access violation in the engine is
      contained in THIS process — the app just observes the worker exit and falls back to an unpruned scan,
      never crashing. The main Yagu.exe never P/Invokes the index FFI, keeping its Native-AOT graph clean.

    How it's built:
      This worker is NOT referenced by Yagu.csproj (a <ProjectReference> would drag it into Yagu's Native-AOT
      publish graph). Instead Yagu.csproj builds it as an isolated child `dotnet publish` and copies the
      output into <app>\index-worker\ — the same pattern used for Yagu.OcrWorker / Yagu.SemanticWorker. It
      SOURCE-LINKS the shared control protocol (IndexWorkerProtocol.cs) so both sides always agree on the wire
      shape. The native yagu_core.dll ships beside Yagu.exe one level up; NativeIndexEngine resolves it there.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Yagu.IndexWorker</RootNamespace>
    <AssemblyName>Yagu.IndexWorker</AssemblyName>
    <!-- Matches the app's per-arch build; the native engine (yagu_core.dll) is arch-specific. -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <!-- NativeIndexEngine uses spans over native pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- This worker intentionally does NOT use Native AOT (isolation is the whole point). -->
    <PublishAot>false</PublishAot>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    SOURCE-LINKED shared control protocol (single source of truth — this file also compiles into Yagu.dll
    for the in-app IndexWorkerClient proxy and into Yagu.Tests). It has no WinUI dependency.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.*" />
  </ItemGroup>

