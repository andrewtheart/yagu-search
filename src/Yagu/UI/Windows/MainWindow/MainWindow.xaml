<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yagu.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Yagu"
    xmlns:vm="using:Yagu.ViewModels"
    xmlns:models="using:Yagu.Models"
    xmlns:tcb="using:TextControlBoxNS"
    xmlns:ui="using:Yagu.UI"
    Title="Yagu - Yet Another Grep Utility">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

          <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
              SizeChanged="OnRootGridSizeChanged"
              PreviewKeyDown="OnRootGridPreviewKeyDown">
                <Grid.Resources>
        <Style x:Key="SearchCardBottomIconButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <DataTemplate x:Key="ResultGroupHeaderTemplate" x:DataType="models:ResultGroupHeaderRow">
            <Button Click="OnResultGroupHeaderClicked"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,8,0,2"
                    Margin="-5,0,-5,0"
                    MinHeight="0">
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}"
                                  FontSize="11"
                                  Width="16"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Title}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}" />
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind SummaryText}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FileGroupHeaderTemplate" x:DataType="models:FileGroup">
            <Grid PointerPressed="OnFileGroupHeaderPointerPressed" PointerReleased="OnFileGroupHeaderPointerReleased" DoubleTapped="OnFileGroupHeaderDoubleTapped" Loaded="OnFileGroupHeaderLoaded" Tag="{x:Bind FilePath}" Background="Transparent">
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="OnFileHeaderContextMenuOpening">
                        <MenuFlyoutItem Text="Preview" Click="OnPreviewSingleFile" Tag="{x:Bind FilePath}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A1;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Preview all selected" Click="OnPreviewSelectedFiles" Tag="{x:Bind FilePath}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A1;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Copy Full Path" Click="OnCopyFileGroupPath" Tag="{x:Bind FilePath}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Open containing folder in Explorer" Click="OnShowFileGroupInExplorer" Tag="{x:Bind FilePath}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Copy Selected File Paths" Click="OnCopySelectedFilePaths">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Copy Selected Files With Content" Click="OnCopySelectedFilesWithContent">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Save Selected File Paths…" Click="OnSaveSelectedFilePaths">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Save Selected Files With Content…" Click="OnSaveSelectedFilesWithContent">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Open with default application" Click="OnOpenFileGroupWithDefaultApplication" Tag="{x:Bind FilePath}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7AC;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="320" MinWidth="0" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox AutomationProperties.AutomationId="FileGroupCheckBox"
                          Style="{StaticResource CircularSelectionCheckBoxStyle}"
                          IsThreeState="False"
                          IsChecked="{x:Bind AllSelected, Mode=OneWay}" MinWidth="32" MinHeight="0" Padding="0" VerticalAlignment="Center"
                          Indeterminate="OnFileGroupCheckBoxIndeterminate"
                          Click="OnFileGroupCheckBoxClicked" />
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Vertical" Spacing="3" VerticalAlignment="Center">
                        <Border Background="#1A6B5A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" MinWidth="112"
                            ToolTipService.ToolTip="Matches found inside the file's contents"
                            Visibility="{x:Bind HasContentMatches, Mode=OneWay}">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="10" Foreground="#B0E0D0" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" TextAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#B0E0D0">
                                        <Run Text="{x:Bind MatchCount}" /><Run Text=" matches" />
                                    </TextBlock>
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE9F5;" FontSize="11" Foreground="#C9B8F0" VerticalAlignment="Center"
                                    ToolTipService.ToolTip="The content index selected this file as a candidate. Match content is always read live from the file."
                                    Visibility="{x:Bind IsIndexAccelerated, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <Border Background="#284B7A" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" MinWidth="112"
                            ToolTipService.ToolTip="The file name matches your search"
                            Visibility="{x:Bind HasFileNameMatch, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8AC;" FontSize="10" Foreground="#A9CBF2" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" TextAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#A9CBF2" Text="file name" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="2" MinWidth="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind FileName}"
                               ToolTipService.ToolTip="{x:Bind FileName}"
                               FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind DirectoryName}" Tag="CompactDir"
                               ToolTipService.ToolTip="{x:Bind DirectoryName}"
                               FontSize="13" Opacity="0.55" TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                        <TextBlock Opacity="0.45" FontSize="11">
                            <Run Text="Modified:" /><Run Text=" " /><Run Text="{x:Bind FormattedDate, Mode=OneWay}" /><Run Text=" | Size:" /><Run Text=" " /><Run Text="{x:Bind FormattedSize, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{x:Bind DirectoryName}" Tag="WideDir"
                           ToolTipService.ToolTip="{x:Bind DirectoryName}"
                           Opacity="0.45" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Left" Margin="12,0,4,0" />
                <Button Grid.Column="4" Click="OnShowFileGroupInExplorer" Tag="{x:Bind FilePath}"
                        Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" Margin="4,0,0,0"
                        ToolTipService.ToolTip="Open containing folder in Explorer">
                    <FontIcon Glyph="&#xED25;" FontSize="12" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FileGroupResultTemplate" x:DataType="models:FileGroup">
            <Grid>
                <!-- No-drawer (file-name-only) row: inset its header by the SAME padding the Expander applies
                     to its header content, so the selection radio lines up with the drawer rows' radio. -->
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource FileGroupHeaderTemplate}"
                                HorizontalContentAlignment="Stretch"
                                Margin="{ThemeResource ExpanderHeaderPadding}"
                                Visibility="{x:Bind IsFileNameOnlyMatch, Mode=OneWay}" />
                <Expander AutomationProperties.AutomationId="FileGroupResultExpander"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Visibility="{x:Bind HasContentMatches, Mode=OneWay}"
                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                          Expanding="OnFileGroupExpanding" Collapsed="OnFileGroupCollapsed">
                    <Expander.Header>
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource FileGroupHeaderTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </Expander.Header>
                <StackPanel>
                    <ItemsControl ItemsSource="{x:Bind VisibleResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResult">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{x:Bind NumberedBefore, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ContextLine">
                                                <Grid ColumnSpacing="3" Padding="4,0,8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind LineNum}" FontFamily="Consolas" FontSize="11" Opacity="0.45"
                                                               HorizontalAlignment="Right" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontFamily="Consolas" FontSize="11" Opacity="0.45"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Padding="0,2,8,2" ColumnSpacing="3" Tapped="OnMatchLineTapped" Background="Transparent">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout Opening="OnMatchLineContextMenuOpening">
                                                <MenuFlyoutItem Text="Copy line" Click="OnCopySingleLine">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy lines" Click="OnCopySelectedLines" Visibility="Collapsed">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Export this to file…" Click="OnExportSingleLine">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Export selected to file…" Click="OnExportSelectedLines" Visibility="Collapsed">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                      AutomationProperties.AutomationId="MatchLineLocationButton"
                                                      AutomationProperties.Name="{x:Bind LineLocationTooltip, Mode=OneWay}"
                                                      Click="OnMatchLineCheckBoxClicked"
                                                      Loaded="OnMatchLineNumberLoaded"
                                                      ToolTipService.ToolTip="{x:Bind LineLocationTooltip, Mode=OneWay}"
                                                      MinWidth="54" MinHeight="22" Padding="5,1" Margin="4,0,2,0"
                                                      CornerRadius="4"
                                                      VerticalAlignment="Center"
                                                      HorizontalContentAlignment="Center">
                                           <TextBlock Text="{x:Bind LineLocationDisplay, Mode=OneWay}"
                                                      FontFamily="Consolas"
                                                      FontSize="12"
                                                      TextAlignment="Center"
                                                      FontWeight="SemiBold" />
                                        </ToggleButton>
                                        <RichTextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="False" Loaded="OnMatchLineLoaded" VerticalAlignment="Center" />
                                        <!-- Phase 1 cross-line (multiline) span marker: "… (+N lines)". Empty (zero-width) for single-line matches. -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind MultilineSpanLabel, Mode=OneWay}"
                                                   FontFamily="Consolas" FontSize="11" FontStyle="Italic"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="6,0,2,0"
                                                   ToolTipService.ToolTip="This match spans multiple lines" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind NumberedAfter, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:ContextLine">
                                                <Grid ColumnSpacing="3" Padding="4,0,8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind LineNum}" FontFamily="Consolas" FontSize="11" Opacity="0.45"
                                                               HorizontalAlignment="Right" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontFamily="Consolas" FontSize="11" Opacity="0.45"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <HyperlinkButton Content="{x:Bind ShowMoreText, Mode=OneWay}"
                                     Visibility="{x:Bind HasMore, Mode=OneWay}"
                                     Click="OnShowMoreClicked"
                                     Tapped="OnShowMoreTapped"
                                     Padding="4,4,0,2" FontSize="12" />
                </StackPanel>
            </Expander>
            </Grid>
        </DataTemplate>

        <local:ResultListItemTemplateSelector x:Key="ResultListItemTemplateSelector"
                                             GroupHeaderTemplate="{StaticResource ResultGroupHeaderTemplate}"
                                             FileGroupTemplate="{StaticResource FileGroupResultTemplate}" />
                </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="Auto" />  <!-- Custom title bar -->
            <RowDefinition Height="Auto" />  <!-- Admin banner -->
            <RowDefinition Height="Auto" />  <!-- Search card -->
            <RowDefinition x:Name="ProgressRow" Height="Auto" />  <!-- Status / progress -->
            <RowDefinition x:Name="SplitPaneRow" Height="*" />     <!-- Split pane -->
            <RowDefinition x:Name="TerminalRow" Height="0" />      <!-- Embedded terminal -->
            <RowDefinition x:Name="StatusBarRow" Height="Auto" />  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0,148,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE721;" FontSize="16" />
                <TextBlock x:Name="AppTitleText" Text="Yagu - Yet Another Grep Utility" Style="{ThemeResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="TitleBarActions" Grid.Row="0" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" HorizontalAlignment="Right"
                    Margin="0,0,156,0" Canvas.ZIndex="100">
            <Button x:Name="PinButton" Click="OnPinToggle" VerticalAlignment="Center"
                    Width="36" Height="32" MinWidth="0" Padding="0"
                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="Minimize to system tray when window loses focus">
                <FontIcon x:Name="PinIcon" Glyph="&#xE77A;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
            <Button Click="OnOpenCredits" VerticalAlignment="Center"
                    Width="36" Height="32" MinWidth="0" Padding="0"
                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="Help">
                <FontIcon Glyph="&#xE897;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
            <Button x:Name="SettingsButton" Click="OnOpenSettings" VerticalAlignment="Center"
                    Width="36" Height="32" MinWidth="0" Padding="0"
                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
                <Button x:Name="CloseWindowButton" Click="OnCloseWindowClick" VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Width="36" Height="32" MinWidth="0" Padding="0"
                    Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    ToolTipService.ToolTip="Close Yagu">
                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
        </StackPanel>

        <!-- Row 1 banners (both collapsed by default): admin-elevation notice, then the non-modal
             app-update notification. Stacked so they never overlap if both are shown at once. -->
        <StackPanel Grid.Row="1" Spacing="0">
        <!-- Admin elevation banner (hidden when running elevated). Background/foreground come from the
             theme-aware Yagu*AdminBanner* brushes in App.xaml so the strip stays yellow AND legible in
             light, dark, and high-contrast themes (a hard-coded dark background left the inherited
             black text invisible in light theme). -->
        <Border x:Name="AdminBanner" Visibility="Collapsed"
                Background="{ThemeResource YaguAdminBannerBackgroundBrush}"
                BorderBrush="{ThemeResource YaguAdminBannerBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4,10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Warning icon + text -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource YaguAdminBannerIconBrush}" VerticalAlignment="Center" />
                    <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource YaguAdminBannerForegroundBrush}">
                        <Run Text="Limited access" />
                        <Run Text="  " />
                        <Run Text="Some files may not be readable without administrator privileges." FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button Content="Learn more..." FontSize="12" Padding="6,1" Click="OnAdminLearnMore" />
                    <Button Content="Restart as Admin" FontSize="12" Padding="6,1" Click="OnRestartAsAdmin" />
                    <Button Content="Don't show again" FontSize="12" Padding="6,1" Click="OnDontShowAdminWarningAgain" />
                </StackPanel>
                <!-- Close button -->
                <Button Grid.Column="2" Click="OnAdminBannerCloseClick"
                        Background="Transparent" BorderThickness="0" Padding="6,2"
                        Foreground="{ThemeResource YaguAdminBannerForegroundBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource YaguAdminBannerForegroundBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- Non-modal app-update notification. Shown only in Automatic mode when a genuinely newer
             release is found (see MainWindow.AppUpdate.cs); Title/Message are set from code-behind.
             Close (X) = remind me later (re-surfaces after the next throttled check). -->
        <InfoBar x:Name="AppUpdateInfoBar"
                 IsOpen="False"
                 Severity="Informational"
                 Margin="16,6,16,0"
                 CloseButtonClick="OnAppUpdateInfoBarRemindLater">
            <InfoBar.ActionButton>
                <Button x:Name="AppUpdateInfoBarViewButton" Content="View release"
                        Click="OnAppUpdateInfoBarViewRelease" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <HyperlinkButton x:Name="AppUpdateInfoBarSkipButton" Content="Skip this version"
                                     Click="OnAppUpdateInfoBarSkipVersion" Padding="0" />
                </StackPanel>
            </InfoBar.Content>
        </InfoBar>
        </StackPanel>

        <!-- Search controls card -->
        <Border x:Name="SearchControlsBorder" Grid.Row="2" Margin="16,10,16,4" Padding="16,18,16,6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowSpacing="12" ColumnSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Directory bar -->
                <FontIcon Grid.Row="0" Grid.Column="0"
                          Glyph="&#xE8B7;" FontSize="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.7" />
                <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2">
                    <AutoSuggestBox
                        x:Name="DirectoryBox"
                        MaxHeight="60"
                        MaxSuggestionListHeight="{x:Bind ViewModel.AutocompleteDropdownMaxHeight, Mode=OneWay}"
                        PlaceholderText="Directory to search (leave empty to search all drives)"
                        Text="{x:Bind ViewModel.Directory, Mode=TwoWay}"
                        ItemsSource="{x:Bind ViewModel.DirectorySuggestions, Mode=OneWay}"
                        TextChanged="OnDirectoryTextChanged"
                        SizeChanged="OnSearchInputSizeChanged"
                        SuggestionChosen="OnDirectorySuggestionChosen"
                        QuerySubmitted="OnDirectoryQuerySubmitted">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:HistorySuggestion">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TimestampDisplay}" Opacity="0.55" FontSize="11"
                                               Margin="16,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                        <!-- Wrap long paths to at most two lines (scrolling internally beyond that) and
                             reserve room on the right so text never flows under the embedded Browse
                             button overlaid at the trailing edge. -->
                        <AutoSuggestBox.TextBoxStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                <Setter Property="Padding" Value="10,6,176,6" />
                            </Style>
                        </AutoSuggestBox.TextBoxStyle>
                    </AutoSuggestBox>
                    <!-- Pin + Index + Browse embedded at the trailing edge of the directory box (overlay,
                         like the query box's clear button). The star pins the current directory as the
                         startup default; the index glyph adds it to the content index; Browse opens the
                         folder picker. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                Margin="0,1,1,1">
                        <StackPanel.Resources>
                            <!-- Selected (checked) look for the pin/index toggles: NO blue fill or border.
                                 Keep the chrome identical to the unselected button and instead tint the
                                 glyph itself with the accent colour (matches the divider style; see the
                                 DirectoryToggleButtons_SelectedTintsGlyphNotChrome pin). -->
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="Transparent" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemAccentColor}" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemAccentColor}" />
                            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="{ThemeResource TextFillColorDisabled}" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource CardStrokeColorDefault}" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="{ThemeResource CardStrokeColorDefault}" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="{ThemeResource CardStrokeColorDefault}" />
                            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="{ThemeResource CardStrokeColorDefault}" />
                        </StackPanel.Resources>
                        <ToggleButton x:Name="PinStartupDirectoryButton" Click="OnPinStartupDirectory"
                                      AccessKey="P"
                                      ToolTipService.ToolTip="Pin this directory as the startup default"
                                      VerticalAlignment="Stretch" Padding="10,0" MinWidth="0"
                                      CornerRadius="0"
                                      Background="Transparent"
                                      BorderThickness="1,0,0,0"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <FontIcon x:Name="PinStartupDirectoryIcon" Glyph="&#xE734;" FontSize="14" />
                        </ToggleButton>
                        <ToggleButton x:Name="IndexDirectoryButton" Click="OnIndexCurrentDirectory"
                                      AccessKey="I"
                                      ToolTipService.ToolTip="Add this directory to the content index"
                                      VerticalAlignment="Stretch" Padding="10,0" MinWidth="0"
                                      CornerRadius="0"
                                      Background="Transparent"
                                      BorderThickness="1,0,0,0"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <FontIcon x:Name="IndexDirectoryIcon" Glyph="&#xE8F1;" FontSize="14" />
                        </ToggleButton>
                        <Button x:Name="BrowseDirectoryButton" Click="OnBrowseDirectory"
                                AccessKey="B" ToolTipService.ToolTip="Browse for folder"
                                VerticalAlignment="Stretch"
                                Padding="10,0" MinWidth="0"
                                CornerRadius="0,4,4,0"
                                Background="Transparent"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xED25;" FontSize="14" />
                                <TextBlock x:Name="BrowseDirectoryLabel" Text="Browse" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Search bar -->
                <FontIcon Grid.Row="1" Grid.Column="0"
                          Glyph="&#xE721;" FontSize="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" Opacity="0.7" />
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                    <AutoSuggestBox
                        x:Name="QueryBox"
                        MinHeight="60"
                        MaxHeight="240"
                        MaxSuggestionListHeight="{x:Bind ViewModel.AutocompleteDropdownMaxHeight, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.QueryPlaceholderText, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
                        QuerySubmitted="OnQuerySubmitted"
                        TextChanged="OnQueryTextChanged"
                        SizeChanged="OnSearchInputSizeChanged"
                        LostFocus="OnQueryLostFocus">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="models:HistorySuggestion">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TimestampDisplay}" Opacity="0.55" FontSize="11"
                                               Margin="16,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                        <!-- Style the inner TextBox so long queries wrap and fill the tall box
                             instead of staying on a single top line. AcceptsReturn stays false so
                             Enter still submits the search. The right padding reserves room for the
                             overlaid InlineSearchToggles (Case/Regex/Multiline/Exact, ~116px + 36px
                             margin) and the QueryClearButton (32px + 4px margin) so wrapped text never
                             flows underneath those controls. -->
                        <AutoSuggestBox.TextBoxStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}">
                                <Setter Property="AcceptsReturn" Value="False" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                <Setter Property="Padding" Value="10,6,158,6" />
                            </Style>
                        </AutoSuggestBox.TextBoxStyle>
                    </AutoSuggestBox>
                    <!-- Inline toggle buttons for search options -->
                    <StackPanel x:Name="InlineSearchToggles"
                                Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,36,0"
                                Visibility="{x:Bind ViewModel.InlineSearchTogglesVisibility, Mode=OneWay}">
                        <!-- Inline calculator / unit-converter answer, shown inside the search box just
                             to the left of the toggles when the query is a math expression (2+2,
                             sqrt(9)*4, 15% of 340) or a unit conversion (5 km to miles). The extra right
                             margin keeps a gap between the pill and the Match case button. -->
                        <Border x:Name="InlineCalculatorBanner"
                                Visibility="{x:Bind ViewModel.InlineCalculatorResultVisibility, Mode=OneWay}"
                                VerticalAlignment="Center" Margin="0,0,10,0" Padding="8,2"
                                MaxWidth="300" CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EF;" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.InlineCalculatorResultText, Mode=OneWay}"
                                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                                <Button Click="OnCopyInlineCalculatorResult"
                                        ToolTipService.ToolTip="Copy the answer"
                                        Padding="4,0" MinWidth="0" Width="24" Height="22"
                                        VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <ToggleButton x:Name="CaseSensitiveToggle"
                                      AccessKey="C"
                                      IsChecked="{x:Bind ViewModel.CaseSensitive, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Match Case (Alt+C)"
                                      Padding="4,2" MinWidth="0" MinHeight="0"
                                      Width="28" Height="24" FontSize="12"
                                      VerticalAlignment="Center">
                            <TextBlock Text="Aa" FontSize="12" FontWeight="SemiBold" />
                        </ToggleButton>
                        <ToggleButton x:Name="RegexToggle"
                                      AccessKey="R"
                                      IsChecked="{x:Bind ViewModel.UseRegex, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Use Regular Expression (Alt+R). This will be enabled if Multiline is enabled"
                                      Padding="4,2" MinWidth="0" MinHeight="0"
                                      Width="28" Height="24" FontSize="12"
                                      VerticalAlignment="Center">
                            <TextBlock Text=".*" FontSize="12" FontFamily="Consolas" />
                        </ToggleButton>
                        <ToggleButton x:Name="MultilineToggle"
                                      AccessKey="M"
                                      IsChecked="{x:Bind ViewModel.Multiline, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Match Across Lines / Multiline — run the query over the whole file so a match can span line breaks. Slower &amp; heavier; best with a narrow scope. (Alt+M)"
                                      Padding="4,2" MinWidth="0" MinHeight="0"
                                      Width="28" Height="24" FontSize="12"
                                      VerticalAlignment="Center">
                            <TextBlock Text="\n" FontSize="12" FontFamily="Consolas" />
                        </ToggleButton>
                        <ToggleButton x:Name="ExactMatchToggle"
                                      AccessKey="E"
                                      IsChecked="{x:Bind ViewModel.ExactMatch, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Exact Match — on: treat the whole query as one term. Off: split on spaces and match any term. (Alt+E). Ignored while Multiline is on"
                                      Padding="4,2" MinWidth="0" MinHeight="0"
                                      Width="28" Height="24" FontSize="12"
                                      VerticalAlignment="Center">
                            <TextBlock Text="&quot;&quot;" FontSize="12" FontFamily="Consolas" />
                        </ToggleButton>
                    </StackPanel>
                    <Button x:Name="QueryClearButton"
                            Width="32" Height="32" MinWidth="0" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Background="Transparent" BorderThickness="0"
                            Visibility="{x:Bind ViewModel.HasQueryText, Mode=OneWay}"
                            Click="OnQueryClearClick"
                            ToolTipService.ToolTip="Clear query">
                        <FontIcon Glyph="&#xE894;" FontSize="12" />
                    </Button>
                </Grid>
                <!-- Bottom action bar: Advanced Options (fills, left), then the utility icons, then
                     the primary Search action on the right. One grid so Search's right edge lines up
                     with the Browse button above it. -->
                <Grid x:Name="SearchCardBottomBar" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="SearchCardBottomActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="SearchCardLoadSessionButton"
                                Click="OnLoadSession"
                                Style="{StaticResource SearchCardBottomIconButtonStyle}"
                                Width="32" Height="32"
                                IsEnabled="{x:Bind ViewModel.IsSessionIdle, Mode=OneWay}"
                                ToolTipService.ToolTip="Load a previously saved .yagu-session file">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                        </Button>
                        <Button x:Name="PreSearchTerminalChevron"
                                Click="OnToggleTerminalPane"
                                Style="{StaticResource SearchCardBottomIconButtonStyle}"
                                Width="36" Height="32" MinWidth="0" MinHeight="0"
                                ToolTipService.ToolTip="Toggle embedded terminal">
                            <FontIcon x:Name="PreSearchTerminalChevronIcon"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE70D;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Search action with a chevron mode picker (Traditional/Semantic). The SplitButton
                         only shows while semantic search is available AND idle; during a search the plain
                         button below takes over and morphs into the red Cancel action. -->
                    <SplitButton x:Name="SearchSplitButton"
                                 Click="OnSearchSplitButtonClick"
                                 Visibility="{x:Bind ViewModel.SearchModeSplitButtonVisibility, Mode=OneWay}"
                                 Padding="12,5,12,6" MinWidth="0" MinHeight="32" CornerRadius="6"
                                 ToolTipService.ToolTip="Search (F5) — use the chevron to switch mode">
                        <SplitButton.Resources>
                            <SolidColorBrush x:Key="SplitButtonBackground" Color="{ThemeResource SystemAccentColor}" />
                            <SolidColorBrush x:Key="SplitButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
                            <SolidColorBrush x:Key="SplitButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark1}" />
                            <SolidColorBrush x:Key="SplitButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="White" />
                        </SplitButton.Resources>
                        <SplitButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </SplitButton.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="SearchSplitIcon" Glyph="&#xE721;" FontSize="14" />
                            <TextBlock x:Name="SearchSplitLabel" Text="Search" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="Bottom" Opening="OnSearchModeFlyoutOpening">
                                <MenuFlyoutItem x:Name="TraditionalModeItem" Text="Traditional"
                                                Click="OnSelectTraditionalMode">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE721;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="SemanticModeItem" Text="Semantic"
                                                Click="OnSelectSemanticMode">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF4A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button x:Name="SearchCancelButton" Click="OnSearchCancelClick" Style="{ThemeResource AccentButtonStyle}" Padding="12,5,12,6" MinWidth="0" MinHeight="32" CornerRadius="6"
                            Visibility="{x:Bind ViewModel.SearchActionButtonVisibility, Mode=OneWay}"
                            ToolTipService.ToolTip="Search (F5)">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="SearchCancelIcon" Glyph="&#xE721;" FontSize="14" />
                            <TextBlock x:Name="SearchCancelLabel" Text="Search" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Advanced options drawer. A flat toggle button whose Flyout drops the tabbed
                     drawer down OVER the desktop (ShouldConstrainToRootBounds="False"), so the
                     window never has to grow vertically — same behavior in launcher and traditional
                     modes. Light-dismiss closes it; the chevron flips up/down from the Flyout's
                     Opened/Closed handlers. -->
                <Button x:Name="AdvancedOptionsToggle"
                        Grid.Column="0"
                        AccessKey="A"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        MinWidth="0" MinHeight="48" Padding="4,0" FontSize="12">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Advanced Options" VerticalAlignment="Center" FontSize="13.5" />
                        <FontIcon x:Name="AdvancedOptionsExpandGlyph"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Glyph="&#xE70D;" FontSize="13"
                                  VerticalAlignment="Center" Opacity="0.9" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout x:Name="AdvancedOptionsFlyout"
                                Placement="BottomEdgeAlignedLeft"
                                ShouldConstrainToRootBounds="False"
                                Opened="OnAdvancedOptionsFlyoutOpened"
                                Closing="OnAdvancedOptionsFlyoutClosing"
                                Closed="OnAdvancedOptionsFlyoutClosed">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MaxWidth" Value="2400" />
                                    <Setter Property="MaxHeight" Value="2400" />
                                    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <!-- ScrollViewer keeps the drawer fully usable at short window
                                 heights: when the options exceed the available space a vertical
                                 scrollbar appears instead of the content being clipped. The
                                 MaxHeight is set dynamically in code-behind. -->
                            <ScrollViewer x:Name="AdvancedOptionsScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          VerticalScrollMode="Auto"
                                  HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Border x:Name="AdvancedOptionsDrawerBodyBorder"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0" CornerRadius="8" Padding="0">
                            <Grid MinHeight="272">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,1,0">
                                        <ListView x:Name="AdvancedOptionsTabList"
                                                  SelectionMode="Single"
                                                  SelectedIndex="0"
                                                  Padding="8,8,8,8"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  SelectionChanged="OnAdvancedOptionsTabSelectionChanged">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="Padding" Value="10,8" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="CornerRadius" Value="6" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="MinHeight" Value="34" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListViewItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE721;" FontSize="12" />
                                                    <TextBlock Text="Search" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ListViewItem>
                                            <ListViewItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE945;" FontSize="12" />
                                                    <TextBlock Text="Quick searches" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ListViewItem>
                                            <ListViewItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE71C;" FontSize="12" />
                                                    <TextBlock Text="Filters" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ListViewItem>
                                            <ListViewItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                                    <TextBlock Text="Size" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ListViewItem>
                                            <ListViewItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE787;" FontSize="12" />
                                                    <TextBlock Text="Dates" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ListViewItem>
                                            <ListViewItem>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                                                    <TextBlock Text="Advanced" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ListViewItem>
                                        </ListView>
                                    </Border>

                                    <Grid Grid.Column="1" Padding="22,16,18,16">
                                        <!-- Search tab -->
                                        <StackPanel x:Name="AdvancedOptionsSearchTabContent" Spacing="14">
                                            <TextBlock Text="Search" FontSize="16" FontWeight="SemiBold" />
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Search mode" Opacity="0.75" />
                                                <ComboBox SelectedIndex="{x:Bind ViewModel.SearchModeIndex, Mode=TwoWay}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center">
                                                    <ComboBoxItem Content="Content + Names"
                                                                  ToolTipService.ToolTip="Search file contents and match file names against the query" />
                                                    <ComboBoxItem Content="Content only"
                                                                  ToolTipService.ToolTip="Search inside file contents only; ignore file names" />
                                                    <ComboBoxItem Content="File names only"
                                                                  ToolTipService.ToolTip="Match file names against the query without reading file contents" />
                                                    <ComboBoxItem Content="File name, then content"
                                                                  ToolTipService.ToolTip="First filter by file name, then search contents of matching files" />
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <CheckBox x:Name="MultilineAdvancedToggle"
                                                          Content="Match across lines (multiline)"
                                                          IsChecked="{x:Bind ViewModel.Multiline, Mode=TwoWay}"
                                                          ToolTipService.ToolTip="Run the query over the whole file so a single match can span line breaks (ripgrep -U). Reads whole files, is slower and heavier, and is best paired with a narrower scope than a whole drive." />
                                                <CheckBox x:Name="MultilineDotAllToggle"
                                                          Content="&#8226; . matches newlines"
                                                          Margin="24,0,0,0"
                                                          IsEnabled="{x:Bind ViewModel.Multiline, Mode=OneWay}"
                                                          IsChecked="{x:Bind ViewModel.MultilineDotAll, Mode=TwoWay}"
                                                          ToolTipService.ToolTip="When on, the dot (.) also matches newline characters (ripgrep --multiline-dotall / inline (?s))." />
                                            </StackPanel>

                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Path filters" Opacity="0.75"
                                                           FontWeight="SemiBold" />
                                                <StackPanel Spacing="8">
                                                    <Grid RowSpacing="4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- MinWidth keeps the Include box at least as wide as its example text when the drawer is compressed beside the preview pane. -->
                                                            <ColumnDefinition Width="*" MinWidth="290" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="#0078D4" CornerRadius="8" Padding="8,2"
                                                                    VerticalAlignment="Center"
                                                                    ToolTipService.ToolTip="Files to include. In Glob mode, use extensions, globs, or path segments. In Regex mode, match the normalized full path.">
                                                                <TextBlock Text="Include" FontSize="11" Foreground="White"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <ComboBox Grid.Column="2"
                                                                      SelectedIndex="{x:Bind ViewModel.IncludeFilterModeIndex, Mode=TwoWay}"
                                                                      Width="88" Height="30" MinWidth="0" Padding="8,0"
                                                                      FontSize="12" VerticalAlignment="Center"
                                                                      ToolTipService.ToolTip="Include filter mode">
                                                                <x:String>Glob</x:String>
                                                                <x:String>Regex</x:String>
                                                            </ComboBox>
                                                        </Grid>
                                                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="IncludeFilterBox"
                                                                 PlaceholderText="{x:Bind ViewModel.IncludeFilterPlaceholder, Mode=OneWay}"
                                                                 ui:PlaceholderTextStyler.Italic="True"
                                                                 Text="{x:Bind ViewModel.IncludeGlobs, Mode=TwoWay}"
                                                                 Padding="8,4"
                                                                 TextChanged="OnFilterBoxTextChanged"
                                                                 GotFocus="OnFilterBoxGotFocus"
                                                                 LostFocus="OnFilterBoxLostFocus" />
                                                    </Grid>
                                                    <Grid RowSpacing="4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- MinWidth keeps the Exclude box at least as wide as its example text when the drawer is compressed beside the preview pane. -->
                                                            <ColumnDefinition Width="*" MinWidth="290" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="#0078D4" CornerRadius="8" Padding="8,2"
                                                                    VerticalAlignment="Center"
                                                                    ToolTipService.ToolTip="Files to exclude. In Glob mode, use extensions, globs, or path segments. In Regex mode, match the normalized full path.">
                                                                <TextBlock Text="Exclude" FontSize="11" Foreground="White"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <ComboBox Grid.Column="2"
                                                                      SelectedIndex="{x:Bind ViewModel.ExcludeFilterModeIndex, Mode=TwoWay}"
                                                                      Width="88" Height="30" MinWidth="0" Padding="8,0"
                                                                      FontSize="12" VerticalAlignment="Center"
                                                                      ToolTipService.ToolTip="Exclude filter mode">
                                                                <x:String>Glob</x:String>
                                                                <x:String>Regex</x:String>
                                                            </ComboBox>
                                                        </Grid>
                                                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="ExcludeFilterBox"
                                                                 PlaceholderText="{x:Bind ViewModel.ExcludeFilterPlaceholder, Mode=OneWay}"
                                                                 ui:PlaceholderTextStyler.Italic="True"
                                                                 Text="{x:Bind ViewModel.ExcludeGlobs, Mode=TwoWay}"
                                                                 Padding="8,4"
                                                                 TextChanged="OnFilterBoxTextChanged"
                                                                 GotFocus="OnFilterBoxGotFocus"
                                                                 LostFocus="OnFilterBoxLostFocus" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Quick searches tab -->
                                        <StackPanel x:Name="AdvancedOptionsQuickSearchesTabContent" Spacing="10" Visibility="Collapsed">
                                            <TextBlock Text="Quick searches" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                                                       Text="One-click searches for things developers hunt for across a codebase. Each loads a regex into the box (Traditional mode) and runs immediately over the current directory." />
                                            <StackPanel x:Name="QuickSearchesPanel" Spacing="6">
                                                <Button x:Name="FindCodeAnnotationsButton"
                                                        Click="OnFindCodeAnnotations"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="Load a whole-word regex over TODO, FIXME, HACK, BUG, XXX, NOTE, OPTIMIZE and REVIEW, then search — surfaces every outstanding code annotation.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                                        <TextBlock Text="Find code annotations (TODO / FIXME…)" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="merge-conflicts" Click="OnQuickSearch"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="Find unresolved Git merge-conflict markers left in files after a bad merge.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                                                        <TextBlock Text="Merge conflict markers" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="debug-output" Click="OnQuickSearch"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="Find leftover debug output — console.log, print(), printf, System.out.print, Debug.Write/Log, fmt.Print.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xEBE8;" FontSize="14" />
                                                        <TextBlock Text="Leftover debug output" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="secrets" Click="OnQuickSearch"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="First-pass scan for hardcoded credentials — assignments to api key, secret, password, token, access key, or connection string.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                                        <TextBlock Text="Possible secrets / credentials" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="urls" Click="OnQuickSearch"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="Find every http(s) URL — handy for auditing endpoints and links.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                                        <TextBlock Text="URLs / links" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="emails" Click="OnQuickSearch"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="Find email addresses in the files.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE715;" FontSize="14" />
                                                        <TextBlock Text="Email addresses" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="empty-catch" Click="OnQuickSearch"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="Find empty catch blocks that silently swallow exceptions.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                                                        <TextBlock Text="Empty catch blocks" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="deprecated" Click="OnQuickSearch"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="Find APIs marked deprecated or obsolete — @deprecated, [Obsolete], @Deprecated.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE81C;" FontSize="14" />
                                                        <TextBlock Text="Deprecated / obsolete markers" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Tag="guids" Click="OnQuickSearch"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        ToolTipService.ToolTip="Find GUIDs / UUIDs in the files.">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                                                        <TextBlock Text="GUIDs / UUIDs" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Filters tab -->
                                        <StackPanel x:Name="AdvancedOptionsFiltersTabContent" Spacing="18" Visibility="Collapsed">
                                            <TextBlock Text="Filters" FontSize="16" FontWeight="SemiBold" />
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="File type filter" Opacity="0.75" />
                                                <Grid x:Name="SkipExtRow">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,0,6">
                                                        <ToggleSwitch x:Name="ObeyGitignoreCheckBox" OnContent="Obey .gitignore" OffContent="Obey .gitignore"
                                                                      IsOn="{x:Bind ViewModel.ObeyGitignore, Mode=TwoWay}" MinWidth="0"
                                                                      Toggled="OnObeyGitignoreToggled" />
                                                        <FontIcon Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                  ToolTipService.ToolTip="Enabling this decreases search performance due to extra .gitignore processing on every folder encountered during the scan." />
                                                    </StackPanel>
                                                    <DropDownButton Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left"
                                                                    Content="{x:Bind ViewModel.SkipExtensionsSummary, Mode=OneWay}"
                                                                    FontSize="12"
                                                                    ToolTipService.ToolTip="Extensions to skip during search">
                                                        <DropDownButton.Flyout>
                                                            <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                                                <StackPanel Width="320" Spacing="2">
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Skip Extensions" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <HyperlinkButton Grid.Column="1" Content="All" Click="OnSkipExtSelectAll" Padding="4,2" />
                                                                        <HyperlinkButton Grid.Column="2" Content="None" Click="OnSkipExtSelectNone" Padding="4,2" />
                                                                    </Grid>
                                                                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                                                        <ItemsRepeater x:Name="SkipExtRepeater"
                                                                                       ItemsSource="{x:Bind ViewModel.SkipExtensionItems, Mode=OneWay}">
                                                                            <ItemsRepeater.Layout>
                                                                                <StackLayout Spacing="0" />
                                                                            </ItemsRepeater.Layout>
                                                                            <ItemsRepeater.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:SkipExtensionItem">
                                                                                    <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                                              MinWidth="0" MinHeight="0" Padding="6,2"
                                                                                              Checked="OnSkipExtToggled" Unchecked="OnSkipExtToggled">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                            <TextBlock Text="{x:Bind Extension}" FontFamily="Consolas" Width="50" />
                                                                                            <TextBlock Text="{x:Bind Category}" Opacity="0.5" FontSize="11" />
                                                                                        </StackPanel>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </ItemsRepeater.ItemTemplate>
                                                                        </ItemsRepeater>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </Flyout>
                                                        </DropDownButton.Flyout>
                                                    </DropDownButton>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Spacing="10">
                                                <TextBlock Text="Content options" Opacity="0.75" />
                                                <Grid x:Name="BinaryExtRow">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <ToggleSwitch Grid.Row="0" Grid.ColumnSpan="2" OnContent="Search binary" OffContent="Search binary"
                                                                  IsOn="{x:Bind ViewModel.SearchBinary, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" MinWidth="0" Margin="0,0,0,6" />
                                                    <DropDownButton Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left"
                                                                    Content="{x:Bind ViewModel.BinaryExtensionsSummary, Mode=OneWay}"
                                                                    Visibility="{x:Bind ViewModel.BinaryExtensionsVisibility, Mode=OneWay}"
                                                                    FontSize="12"
                                                                    ToolTipService.ToolTip="Select which binary / build-artifact file types to include in the search (checked = searched; unchecked types are skipped)">
                                                        <DropDownButton.Flyout>
                                                            <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                                                <StackPanel Width="320" Spacing="2">
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Binary Extensions" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <HyperlinkButton Grid.Column="1" Content="All" Click="OnBinaryExtSelectAll" Padding="4,2" />
                                                                        <HyperlinkButton Grid.Column="2" Content="None" Click="OnBinaryExtSelectNone" Padding="4,2" />
                                                                    </Grid>
                                                                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                                                        <ItemsRepeater x:Name="BinaryExtRepeater"
                                                                                       ItemsSource="{x:Bind ViewModel.BinaryExtensionItems, Mode=OneWay}">
                                                                            <ItemsRepeater.Layout>
                                                                                <StackLayout Spacing="0" />
                                                                            </ItemsRepeater.Layout>
                                                                            <ItemsRepeater.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:SkipExtensionItem">
                                                                                    <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                                              MinWidth="0" MinHeight="0" Padding="6,2"
                                                                                              Checked="OnBinaryExtToggled" Unchecked="OnBinaryExtToggled">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                            <TextBlock Text="{x:Bind Extension}" FontFamily="Consolas" Width="50" />
                                                                                            <TextBlock Text="{x:Bind Category}" Opacity="0.5" FontSize="11" />
                                                                                        </StackPanel>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </ItemsRepeater.ItemTemplate>
                                                                        </ItemsRepeater>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </Flyout>
                                                        </DropDownButton.Flyout>
                                                    </DropDownButton>
                                                </Grid>
                                                <Grid x:Name="ArchiveExtRow">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,0,6">
                                                        <ToggleSwitch OnContent="Search archives" OffContent="Search archives"
                                                                      IsOn="{x:Bind ViewModel.SearchInsideArchives, Mode=TwoWay}"
                                                                      MinWidth="0" />
                                                        <FontIcon Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                  ToolTipService.ToolTip="Enabling this decreases search performance — archives must be decompressed and scanned individually. Only enable if you expect results inside ZIP files." />
                                                    </StackPanel>
                                                    <DropDownButton Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left"
                                                                    Content="{x:Bind ViewModel.ArchiveExtensionsSummary, Mode=OneWay}"
                                                                    Visibility="{x:Bind ViewModel.ArchiveExtensionsVisibility, Mode=OneWay}"
                                                                    FontSize="12"
                                                                    ToolTipService.ToolTip="ZIP-like extensions to bypass from skip list when archive search is on">
                                                        <DropDownButton.Flyout>
                                                            <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                                                <StackPanel Width="320" Spacing="2">
                                                                    <Grid Margin="0,0,0,6">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="Archive Extensions" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <HyperlinkButton Grid.Column="1" Content="All" Click="OnArchiveExtSelectAll" Padding="4,2" />
                                                                        <HyperlinkButton Grid.Column="2" Content="None" Click="OnArchiveExtSelectNone" Padding="4,2" />
                                                                    </Grid>
                                                                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                                                        <ItemsRepeater x:Name="ArchiveExtRepeater"
                                                                                       ItemsSource="{x:Bind ViewModel.ArchiveExtensionItems, Mode=OneWay}">
                                                                            <ItemsRepeater.Layout>
                                                                                <StackLayout Spacing="0" />
                                                                            </ItemsRepeater.Layout>
                                                                            <ItemsRepeater.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:SkipExtensionItem">
                                                                                    <CheckBox IsChecked="{x:Bind IsEnabled, Mode=TwoWay}"
                                                                                              MinWidth="0" MinHeight="0" Padding="6,2"
                                                                                              Checked="OnArchiveExtToggled" Unchecked="OnArchiveExtToggled">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                            <TextBlock Text="{x:Bind Extension}" FontFamily="Consolas" Width="80" />
                                                                                            <TextBlock Text="{x:Bind Category}" Opacity="0.5" FontSize="11" />
                                                                                        </StackPanel>
                                                                                    </CheckBox>
                                                                                </DataTemplate>
                                                                            </ItemsRepeater.ItemTemplate>
                                                                        </ItemsRepeater>
                                                                    </ScrollViewer>
                                                                </StackPanel>
                                                            </Flyout>
                                                        </DropDownButton.Flyout>
                                                    </DropDownButton>
                                                </Grid>
                                                <StackPanel x:Name="CloudFilesRow" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <ToggleSwitch OnContent="Search online-only cloud files" OffContent="Search online-only cloud files"
                                                                  IsOn="{x:Bind ViewModel.SearchOnlineOnlyFiles, Mode=TwoWay}"
                                                                  MinWidth="0" />
                                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                              ToolTipService.ToolTip="When on, OneDrive/Google Drive online-only placeholder files are downloaded on demand and searched — but only while the sync provider is running. Off by default: cloud-only files are skipped so the scan can't hang on a download. Can be slow and use network/disk." />
                                               </StackPanel>
                                               <StackPanel x:Name="HiddenFilesRow" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                   <ToggleSwitch OnContent="Search hidden files" OffContent="Search hidden files"
                                                                 IsOn="{x:Bind ViewModel.SearchHiddenFiles, Mode=TwoWay}"
                                                                 MinWidth="0" />
                                                   <FontIcon Glyph="&#xE946;" FontSize="12" VerticalAlignment="Center"
                                                             Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                             ToolTipService.ToolTip="When on (default), files and folders with the Windows Hidden attribute are searched. When off, hidden items are excluded. System files (e.g. pagefile.sys) are always skipped by the file walker regardless of this setting." />
                                               </StackPanel>
                                               <StackPanel x:Name="ImageTextRow" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                   <ToggleSwitch OnContent="Search image text" OffContent="Search image text"
                                                                 IsOn="{x:Bind ViewModel.SearchImageText, Mode=TwoWay}"
                                                                 MinWidth="0" />
                                                   <FontIcon Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                                                             Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                             ToolTipService.ToolTip="When on, raster images (PNG/JPG/etc.) are OCR'd on a background queue and their recognized text is searched. Off by default. OCR runs on a separate thread so it never slows the file scan; image matches appear as they finish. Choose the OCR engine (PaddleSharp or Tesseract) in Settings." />
                                               </StackPanel>
                                               <StackPanel x:Name="PdfTextRow" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                   <ToggleSwitch OnContent="Search PDF text" OffContent="Search PDF text"
                                                                 IsOn="{x:Bind ViewModel.SearchPdfText, Mode=TwoWay}"
                                                                 MinWidth="0" />
                                                   <FontIcon Glyph="&#xE7BA;" FontSize="12" VerticalAlignment="Center"
                                                             Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                             ToolTipService.ToolTip="When on, PDF files are converted to text on a background queue (via the bundled Xpdf pdftotext) and their extracted text is searched. Off by default. Extraction runs on a separate thread so it never slows the file scan; PDF matches appear as they finish. Only the embedded text layer is read — scanned/image-only PDFs yield no text." />
                                               </StackPanel>
                                               <StackPanel x:Name="UseContentIndexRow" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                   <ToggleSwitch OnContent="Use content index" OffContent="Use content index"
                                                                 IsOn="{x:Bind ViewModel.UseContentIndex, Mode=TwoWay}"
                                                                 MinWidth="0" />
                                                   <FontIcon Glyph="&#xE9F5;" FontSize="12" VerticalAlignment="Center"
                                                             Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                             ToolTipService.ToolTip="When on, this search uses the opt-in persistent content index to skip files that cannot contain a match, then verifies the rest live — an accelerator only. Mirrors the Indexing settings default and requires content indexing to be enabled in Settings ▸ Indexing. It never changes results and is independent of image/PDF/archive search. Equivalent to the CLI --use-index / --no-index flags." />
                                               </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Size tab -->
                                        <StackPanel x:Name="AdvancedOptionsSizeTabContent" Spacing="14" Visibility="Collapsed">
                                            <TextBlock Text="Size" FontSize="16" FontWeight="SemiBold" />
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Min MB" Opacity="0.75" />
                                                <NumberBox Value="{x:Bind ViewModel.MinFileSizeMB, Mode=TwoWay}"
                                                           Minimum="0"
                                                           Width="150"
                                                           HorizontalAlignment="Left"
                                                           ui:PlaceholderTextStyler.Italic="True"
                                                           PlaceholderText="e.g. 1, 10.5, 100"
                                                           SpinButtonPlacementMode="Hidden"
                                                           ToolTipService.ToolTip="Minimum file size in MB. Leave blank for no lower limit." />
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Max MB" Opacity="0.75" />
                                                <NumberBox Value="{x:Bind ViewModel.MaxFileSizeMB, Mode=TwoWay}"
                                                           Minimum="0"
                                                           Width="150"
                                                           HorizontalAlignment="Left"
                                                           ui:PlaceholderTextStyler.Italic="True"
                                                           PlaceholderText="e.g. 50, 500, 1024"
                                                           SpinButtonPlacementMode="Hidden"
                                                           ToolTipService.ToolTip="Maximum file size in MB. Leave blank for no upper limit." />
                                            </StackPanel>
                                            <Border Background="#1A0078D4" BorderBrush="#445CA8D6"
                                                    BorderThickness="1" CornerRadius="4" Padding="10,8"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#8CBCEB" />
                                                    <TextBlock Text="Leave a field empty to ignore that limit."
                                                               TextWrapping="Wrap" Opacity="0.8" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Dates tab -->
                                        <StackPanel x:Name="AdvancedOptionsDatesTabContent" Spacing="14" Visibility="Collapsed">
                                            <TextBlock Text="Dates" FontSize="16" FontWeight="SemiBold" />
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Created date" Opacity="0.75" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="From" FontSize="11" Opacity="0.65" />
                                                        <CalendarDatePicker Date="{x:Bind ViewModel.CreatedAfterDate, Mode=TwoWay}"
                                                                            PlaceholderText="Select start date" MinWidth="160"
                                                                            ToolTipService.ToolTip="Only include files created on or after this date." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="To" FontSize="11" Opacity="0.65" />
                                                        <CalendarDatePicker Date="{x:Bind ViewModel.CreatedBeforeDate, Mode=TwoWay}"
                                                                            PlaceholderText="Select end date" MinWidth="160"
                                                                            ToolTipService.ToolTip="Only include files created on or before this date." />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Modified date" Opacity="0.75" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="From" FontSize="11" Opacity="0.65" />
                                                        <CalendarDatePicker Date="{x:Bind ViewModel.ModifiedAfterDate, Mode=TwoWay}"
                                                                            PlaceholderText="Select start date" MinWidth="160"
                                                                            ToolTipService.ToolTip="Only include files modified on or after this date." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="To" FontSize="11" Opacity="0.65" />
                                                        <CalendarDatePicker Date="{x:Bind ViewModel.ModifiedBeforeDate, Mode=TwoWay}"
                                                                            PlaceholderText="Select end date" MinWidth="160"
                                                                            ToolTipService.ToolTip="Only include files modified on or before this date." />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                            <Border Background="#1A0078D4" BorderBrush="#445CA8D6"
                                                    BorderThickness="1" CornerRadius="4" Padding="10,8"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#8CBCEB" />
                                                    <TextBlock Text="Dates are inclusive."
                                                               TextWrapping="Wrap" Opacity="0.8" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Advanced tab -->
                                        <StackPanel x:Name="AdvancedOptionsAdvancedTabContent" Spacing="14" Visibility="Collapsed">
                                            <TextBlock Text="Advanced" FontSize="16" FontWeight="SemiBold" />
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Max depth" Opacity="0.75" />
                                                <NumberBox Value="{x:Bind ViewModel.MaxSearchDepth, Mode=TwoWay}"
                                                           Minimum="0"
                                                           Width="150"
                                                           HorizontalAlignment="Left"
                                                           ui:PlaceholderTextStyler.Italic="True"
                                                           PlaceholderText="e.g. 1, 2, 10"
                                                           SpinButtonPlacementMode="Hidden"
                                                           ToolTipService.ToolTip="Maximum subdirectory depth for the current search only (0 = unlimited)." />
                                            </StackPanel>
                                            <Border Background="#1A0078D4" BorderBrush="#445CA8D6"
                                                    BorderThickness="1" CornerRadius="4" Padding="10,8" MaxWidth="340"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="#8CBCEB" />
                                                    <TextBlock Text="Limit how deep the search goes into subfolders. Leave empty for unlimited."
                                                               TextWrapping="Wrap" Opacity="0.8" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="12,8">
                                    <Grid>
                                        <Button x:Name="GenerateCliCommandButton"
                                                Click="OnGenerateCliCommandClick"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                MinWidth="0" Padding="8,5"
                                                ToolTipService.ToolTip="Generate an equivalent command-line search">
                                            <FlyoutBase.AttachedFlyout>
                                                <Flyout x:Name="GeneratedCliCommandFlyout"
                                                        Placement="Top"
                                                        ShouldConstrainToRootBounds="False">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="Padding" Value="12,10" />
                                                            <Setter Property="CornerRadius" Value="8" />
                                                            <Setter Property="MinWidth" Value="0" />
                                                            <Setter Property="MaxWidth" Value="760" />
                                                            <Setter Property="MaxHeight" Value="600" />
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <Grid RowSpacing="8" MinWidth="380" MaxWidth="720">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="CLI command"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center" />
                                                            <Button x:Name="CopyGeneratedCliCommandButton" Grid.Column="1"
                                                                    Click="OnCopyGeneratedCliCommandClick"
                                                                    Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    ToolTipService.ToolTip="Copy command">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                            </Button>
                                                            <Button x:Name="SendGeneratedCliCommandToTerminalButton" Grid.Column="2"
                                                                    Click="OnSendGeneratedCliCommandToTerminalClick"
                                                                    Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    ToolTipService.ToolTip="Send command to terminal">
                                                                <FontIcon Glyph="&#xE756;" FontSize="12" />
                                                            </Button>
                                                            <Button x:Name="CloseGeneratedCliCommandOverlayButton" Grid.Column="3"
                                                                    Click="OnCloseGeneratedCliCommandOverlayClick"
                                                                    Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    ToolTipService.ToolTip="Close">
                                                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                            </Button>
                                                        </Grid>
                                                        <ToggleSwitch x:Name="IncludeSavedSettingCliOptionsToggle"
                                                                      Grid.Row="1"
                                                                      Header="Options already saved in settings"
                                                                      IsOn="False"
                                                                      OnContent="Include"
                                                                      OffContent="Omit"
                                                                      FontSize="12"
                                                                      ToolTipService.ToolTip="Omit options that already match the current settings file to make the command shorter."
                                                                      Toggled="OnGeneratedCliCommandSavedSettingOptionsToggled" />
                                                        <Border x:Name="GeneratedCliCommandBubble"
                                                                Grid.Row="2"
                                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="10,8">
                                                            <ScrollViewer MaxHeight="360"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          VerticalScrollBarVisibility="Auto">
                                                                <TextBlock x:Name="GeneratedCliCommandText"
                                                                           FontFamily="Consolas"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           IsTextSelectionEnabled="True" />
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Grid>
                                                </Flyout>
                                            </FlyoutBase.AttachedFlyout>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE756;" FontSize="11" />
                                                <TextBlock Text="Generate CLI command" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                            <Button Content="Save as Defaults" Click="OnAdvancedOptionsSaveDefaultsClick"
                                                    ToolTipService.ToolTip="Save the current Advanced Options to your settings file as the default options" />
                                            <Button Content="Reset" Click="OnAdvancedOptionsResetClick"
                                                    ToolTipService.ToolTip="Restore Advanced Options to the current settings defaults" />
                                            <Button Content="Apply" Style="{ThemeResource AccentButtonStyle}"
                                                    Click="OnAdvancedOptionsApplyClick"
                                                    ToolTipService.ToolTip="Apply current Advanced Options and close the panel" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Status / progress: session progress, fallback/error text, and the semantic-status row.
             The SEARCH progress bar + percentage is a floating overlay (SearchProgressOverlay, below) so it
             never reserves flow height nor pushes the results/preview panes down. -->
        <StackPanel x:Name="SearchStatusPanel" Grid.Row="3" Padding="16,2,16,2" Spacing="4">
            <Grid Visibility="{x:Bind ViewModel.IsSessionBusy, Mode=OneWay}" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Minimum="0" Maximum="100"
                             Value="{x:Bind ViewModel.SessionProgressPercent, Mode=OneWay}"
                             IsIndeterminate="False" CornerRadius="3" Height="6"
                             ToolTipService.ToolTip="{x:Bind ViewModel.SessionProgressText, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Text="{x:Bind ViewModel.SessionProgressText, Mode=OneWay}" />
            </Grid>
            <TextBlock Foreground="OrangeRed"
                       Visibility="{x:Bind ViewModel.HasFallbackReason, Mode=OneWay}"
                       Text="{x:Bind ViewModel.FallbackReason, Mode=OneWay}" />
            <TextBlock Foreground="Red"
                       Visibility="{x:Bind ViewModel.HasErrorText, Mode=OneWay}"
                       Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
            <!-- Semantic translation status / interpretation (Foundry Local). Lives here, below the
                 search card, so it never shifts the search box when it appears. -->
            <StackPanel x:Name="QueryModeBar" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.SemanticStatusBarVisibility, Mode=OneWay}">
                <ProgressRing Width="16" Height="16"
                              IsActive="{x:Bind ViewModel.IsTranslatingSemanticQuery, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.SemanticStatusText, Mode=OneWay}"
                           VerticalAlignment="Center" FontSize="12" Opacity="0.8"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <!-- Search progress overlay: the determinate bar + percentage float in the gap between the search
             card and the results/preview panes. Grid.RowSpan into the split-pane (star) row means the Auto
             ProgressRow never grows, so showing/hiding it never shifts the panes (unlike reserving height).
             A small negative top margin centers the bar on the inter-card gap so it does not cover the
             results header, and IsHitTestVisible=False keeps the header buttons underneath clickable. -->
        <Grid x:Name="SearchProgressOverlay" Grid.Row="3" Grid.RowSpan="2"
              VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,-6,16,0" ColumnSpacing="8"
              Canvas.ZIndex="6" IsHitTestVisible="False"
              Visibility="{x:Bind ViewModel.IsSearchActive, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0"
                         Maximum="{x:Bind ViewModel.TotalFiles, Mode=OneWay}"
                         Value="{x:Bind ViewModel.FilesScanned, Mode=OneWay}"
                         IsIndeterminate="{x:Bind ViewModel.SearchProgressIndeterminate, Mode=OneWay}" CornerRadius="3" Height="6"
                         VerticalAlignment="Center"
                         ToolTipService.ToolTip="{x:Bind ViewModel.ProgressTooltip, Mode=OneWay}" />
            <TextBlock x:Name="SearchProgressPercentText" Grid.Column="1"
                       MinWidth="34"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Opacity="0.8"
                       Text="{x:Bind ViewModel.SearchProgressRightLabel, Mode=OneWay}" />
        </Grid>

        <!-- Split pane: results + preview -->
          <Grid x:Name="SplitPaneGrid" Grid.Row="4" Margin="16,2,16,4"
              SizeChanged="OnTopExpandedPreviewLayoutSourceSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ResultsColumn" Width="*" MinWidth="200" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Results panel card -->
                <Border x:Name="ResultsPanelBorder" Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    SizeChanged="OnTopExpandedPreviewLayoutSourceSizeChanged"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="SelectAllFilesCheckBox"
                                  Style="{StaticResource CircularSelectionCheckBoxStyle}"
                                  ToolTipService.ToolTip="Select / deselect all files"
                                  IsThreeState="False"
                                  IsChecked="False"
                                  Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Loaded="OnSelectAllFilesLoaded"
                                  Indeterminate="OnSelectAllFilesIndeterminate"
                                  Checked="OnSelectAllFilesChecked"
                                  Unchecked="OnSelectAllFilesUnchecked" />
                        <DropDownButton Height="28" MinHeight="0" Padding="6,2" HorizontalContentAlignment="Left" VerticalAlignment="Center" FontSize="12" AccessKey="S" ToolTipService.ToolTip="Sort results">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                                <TextBlock Text="Sort" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout x:Name="SortFlyout" Placement="BottomEdgeAlignedLeft" Opening="OnSortFlyoutOpening">
                                    <StackPanel MinWidth="154" Padding="8,4" Spacing="1">
                                        <Button x:Name="SortNoneButton" Content="None" Click="OnSortNone"
                                            MinHeight="28" Padding="8,0"
                                                HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="0" />
                                        <Grid MinHeight="28" ColumnSpacing="10" Padding="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="# Matches" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button x:Name="SortMatchesAscButton" Click="OnSortMatchesAsc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort # Matches ascending">
                                                    <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                </Button>
                                                <Button x:Name="SortMatchesDescButton" Click="OnSortMatchesDesc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort # Matches descending">
                                                    <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid MinHeight="28" ColumnSpacing="10" Padding="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Date Modified" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button x:Name="SortDateModifiedAscButton" Click="OnSortDateModifiedAsc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort Date Modified ascending">
                                                    <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                </Button>
                                                <Button x:Name="SortDateModifiedDescButton" Click="OnSortDateModifiedDesc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort Date Modified descending">
                                                    <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid MinHeight="28" ColumnSpacing="10" Padding="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="File Size" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button x:Name="SortFileSizeAscButton" Click="OnSortFileSizeAsc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort File Size ascending">
                                                    <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                </Button>
                                                <Button x:Name="SortFileSizeDescButton" Click="OnSortFileSizeDesc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort File Size descending">
                                                    <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid MinHeight="28" ColumnSpacing="10" Padding="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="File Name" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button x:Name="SortFileNameAscButton" Click="OnSortFileNameAsc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort File Name ascending">
                                                    <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                </Button>
                                                <Button x:Name="SortFileNameDescButton" Click="OnSortFileNameDesc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort File Name descending">
                                                    <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Grid MinHeight="28" ColumnSpacing="10" Padding="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Directory" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                <Button x:Name="SortDirectoryAscButton" Click="OnSortDirectoryAsc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort Directory ascending">
                                                    <FontIcon Glyph="&#xE74A;" FontSize="11" />
                                                </Button>
                                                <Button x:Name="SortDirectoryDescButton" Click="OnSortDirectoryDesc"
                                                        Width="26" Height="26" MinWidth="0" MinHeight="0" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Sort Directory descending">
                                                    <FontIcon Glyph="&#xE74B;" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton Height="28" MinHeight="0" Padding="6,2" HorizontalContentAlignment="Left" VerticalAlignment="Center" FontSize="12" AccessKey="G" ToolTipService.ToolTip="Group results by…">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                                <TextBlock Text="Group" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnGroupMenuOpening">
                                    <MenuFlyoutItem x:Name="GroupBreadcrumbItem" IsEnabled="False" Visibility="Collapsed">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="GroupBreadcrumbSeparator" Visibility="Collapsed" />
                                    <MenuFlyoutItem Text="None" Click="OnGroupModeNone" />
                                    <MenuFlyoutSubItem Text="Folder">
                                        <MenuFlyoutItem Text="A-Z" Click="OnGroupFolderAZ" />
                                        <MenuFlyoutItem Text="Z-A" Click="OnGroupFolderZA" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="Date range (Modified)">
                                        <MenuFlyoutItem Text="Recent first" Click="OnGroupDateModifiedRecent" />
                                        <MenuFlyoutItem Text="Older first" Click="OnGroupDateModifiedOlder" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="Date range (Created)">
                                        <MenuFlyoutItem Text="Recent first" Click="OnGroupDateCreatedRecent" />
                                        <MenuFlyoutItem Text="Older first" Click="OnGroupDateCreatedOlder" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="Date range (Modified + Created)">
                                        <MenuFlyoutItem Text="Recent first" Click="OnGroupDateModCreatedRecent" />
                                        <MenuFlyoutItem Text="Older first" Click="OnGroupDateModCreatedOlder" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="Extension">
                                        <MenuFlyoutItem Text="A-Z" Click="OnGroupExtensionAZ" />
                                        <MenuFlyoutItem Text="Z-A" Click="OnGroupExtensionZA" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="File size">
                                        <MenuFlyoutItem Text="Small to large" Click="OnGroupFileSizeSmallLarge" />
                                        <MenuFlyoutItem Text="Large to small" Click="OnGroupFileSizeLargeSmall" />
                                    </MenuFlyoutSubItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton x:Name="ResultsFilterButton" AccessKey="F" Height="28" MinHeight="0" Padding="6,2" HorizontalContentAlignment="Left" VerticalAlignment="Center" FontSize="12" ToolTipService.ToolTip="Filter results">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE71C;" FontSize="12" />
                                <TextBlock Text="Filter" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnFilterMenuOpening">
                                    <MenuFlyoutItem x:Name="FilterBreadcrumbItem" IsEnabled="False" Visibility="Collapsed">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="FilterBreadcrumbSeparator" Visibility="Collapsed" />
                                    <MenuFlyoutSubItem Text="By date">
                                        <MenuFlyoutItem Text="Any date" Click="OnDateFilterNone" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Last day" Click="OnDateFilterPastDay" />
                                        <MenuFlyoutItem Text="Last week" Click="OnDateFilterPastWeek" />
                                        <MenuFlyoutItem Text="Last 2 weeks" Click="OnDateFilterPastTwoWeeks" />
                                        <MenuFlyoutItem Text="Last month" Click="OnDateFilterPastMonth" />
                                        <MenuFlyoutItem Text="Last 3 months" Click="OnDateFilterPastThreeMonths" />
                                        <MenuFlyoutItem Text="Last 6 months" Click="OnDateFilterPastSixMonths" />
                                        <MenuFlyoutItem Text="Last 9 months" Click="OnDateFilterPastNineMonths" />
                                        <MenuFlyoutItem Text="Last year" Click="OnDateFilterPastYear" />
                                        <MenuFlyoutItem Text="Last 2 years" Click="OnDateFilterPastTwoYears" />
                                        <MenuFlyoutItem Text="Last 3 years" Click="OnDateFilterPastThreeYears" />
                                        <MenuFlyoutItem Text="Last 5 years" Click="OnDateFilterPastFiveYears" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem x:Name="ExtensionFilterMenuItem" Text="By extension…" Click="OnByExtensionFilterMenuClicked" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <CheckBox x:Name="AutoScrollResultsCheckBox"
                                  Content="Auto-scroll"
                                  IsChecked="False"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  MinWidth="0"
                                  MinHeight="0"
                                  Padding="4,0,0,0"
                                  Visibility="{x:Bind ViewModel.AutoScrollResultsCheckboxVisibility, Mode=OneWay}"
                                  Checked="OnAutoScrollResultsChanged"
                                  Unchecked="OnAutoScrollResultsChanged"
                                  ToolTipService.ToolTip="Follow new results as they arrive" />
                        <Button x:Name="ResultsOptionsButton"
                                Width="28" Height="28" MinWidth="0" MinHeight="0"
                                Padding="0" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center" ToolTipService.ToolTip="Results options">
                            <FontIcon Glyph="&#xE700;" FontSize="12" />
                            <Button.Flyout>
                                <Flyout x:Name="ResultsOptionsFlyout" Placement="BottomEdgeAlignedRight" Opened="OnResultsOptionsFlyoutOpened">
                                    <StackPanel MinWidth="170" Spacing="6" Padding="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Context:" VerticalAlignment="Center" FontSize="12" Opacity="0.8" />
                                            <NumberBox Value="{x:Bind ViewModel.ContextLines, Mode=TwoWay}" Minimum="0" Maximum="20"
                                                       SpinButtonPlacementMode="Hidden" MinWidth="64" Width="64" FontSize="12"
                                                       ToolTipService.ToolTip="Context lines included with each search result" />
                                        </StackPanel>

                                        <Border Height="1" Margin="0,2" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                        <Button x:Name="ClearResultsButton" Click="OnClearResults" Background="Transparent" BorderThickness="0"
                                                Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                ToolTipService.ToolTip="Clear all results (Ctrl+Shift+Delete)">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE8E6;" FontSize="14" />
                                                <TextBlock Text="Clear all results" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SaveSessionButton" Click="OnSaveSession" Background="Transparent" BorderThickness="0"
                                                Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                IsEnabled="{x:Bind ViewModel.IsSessionIdle, Mode=OneWay}"
                                                ToolTipService.ToolTip="Save current results to a .yagu-session file">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                                <TextBlock Text="Save session" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="LoadSessionButton" Click="OnLoadSession" Background="Transparent" BorderThickness="0"
                                                Padding="8,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                IsEnabled="{x:Bind ViewModel.IsSessionIdle, Mode=OneWay}"
                                                ToolTipService.ToolTip="Load a previously saved .yagu-session file">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                                <TextBlock Text="Load session" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="ExpandResultsButton"
                                Click="OnExpandResultsPanel"
                                Background="Transparent" BorderThickness="0"
                                Width="28" Height="28" MinWidth="0" MinHeight="0"
                                Padding="0" VerticalAlignment="Center"
                                ToolTipService.ToolTip="Expand file list / collapse preview">
                            <FontIcon x:Name="ExpandResultsIcon" Glyph="&#xE740;" FontSize="12" />
                        </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DegradedNoticeText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.MemoryPressureWarningVisibility, Mode=OneWay}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="12" Foreground="DarkOrange" Opacity="0.9" Margin="8,0,8,0" />
                        <Grid Grid.Column="2" MinWidth="200" VerticalAlignment="Center"
                              Margin="0,0,4,0"
                              Visibility="{x:Bind ViewModel.ResultFileFilterVisibility, Mode=OneWay}">
                            <TextBox AutomationProperties.AutomationId="ResultFileFilterBox"
                                     PlaceholderText="Filter files…"
                                     Text="{x:Bind ViewModel.FileNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="30,4,8,4" FontSize="12" />
                            <FontIcon Glyph="&#xE71C;" FontSize="12" Opacity="0.65"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="10,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <ListView
                        x:Name="ResultsList"
                        Grid.Row="2"
                        SelectionMode="None"
                        ShowsScrollingPlaceholders="True"
                        IsItemClickEnabled="True"
                        ItemClick="OnResultItemClick"
                        DoubleTapped="OnResultDoubleTapped"
                        KeyDown="OnResultsListKeyDown"
                        PointerPressed="OnResultsListPointerPressed"
                        RightTapped="OnResultsListRightTapped"
                        ItemsSource="{x:Bind ViewModel.ResultRows, Mode=OneWay}"
                        ItemTemplateSelector="{StaticResource ResultListItemTemplateSelector}"
                        SizeChanged="OnResultsListSizeChanged"
                        ContainerContentChanging="OnResultsListContainerContentChanging"
                        Padding="4,0">
                        <ListView.ContextFlyout>
                            <MenuFlyout Opening="OnResultsContextMenuOpening">
                                <MenuFlyoutItem x:Name="CtxPreviewSingle" Text="Preview" Click="OnPreviewSingleFile">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CtxPreviewSelected" Text="Preview all selected" Click="OnPreviewSelectedFiles">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="CtxCopyPaths" Text="Copy File Path" Click="OnCopySelectedFilePaths">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CtxCopyWithContent" Text="Copy File With Content" Click="OnCopySelectedFilesWithContent">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="CtxSavePaths" Text="Save File Path…" Click="OnSaveSelectedFilePaths">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CtxSaveWithContent" Text="Save File With Content…" Click="OnSaveSelectedFilesWithContent">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEDE1;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>

                    <Border x:Name="ResultsFileOverlay" Grid.Row="2"
                            Visibility="Collapsed"
                            VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Margin="0,-6,0,0"
                            Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                            BorderBrush="{ThemeResource SystemAccentColor}"
                            BorderThickness="0,0,0,1"
                            Padding="10,5"
                            Tapped="OnResultsFileOverlayTapped"
                            DoubleTapped="OnResultsFileOverlayDoubleTapped"
                            Canvas.ZIndex="30">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="13" Opacity="0.75"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="ResultsFileOverlayFileName" Grid.Column="1"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ResultsFileOverlayExplorerButton" Grid.Column="2"
                                    Click="OnShowFileGroupInExplorer"
                                    Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Open containing folder in Explorer">
                                <FontIcon Glyph="&#xED25;" FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SplitterBorder" Grid.Column="1" Width="8" Background="Transparent"
                    Visibility="Collapsed"
                    PointerPressed="OnSplitterPressed"
                    PointerMoved="OnSplitterMoved"
                    PointerReleased="OnSplitterReleased"
                    PointerEntered="OnSplitterPointerEntered"
                    PointerExited="OnSplitterPointerExited">
                <!-- Grip dots indicating the splitter can be dragged -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3" Opacity="0.4">
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Preview panel card -->
                <Border x:Name="PreviewPanelBorder" Grid.Column="2"
                    SizeChanged="OnTopExpandedPreviewLayoutSourceSizeChanged"
                    Visibility="Collapsed"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="PreviewHeaderBar" Padding="12,8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PreviewToolbarContent" Orientation="Horizontal" Spacing="4" Visibility="Collapsed" HorizontalAlignment="Left">
                            <!-- File identity (icon + label hidden) -->
                            <FontIcon Glyph="&#xE7B3;" FontSize="12" VerticalAlignment="Center" Opacity="0.6" Visibility="Collapsed" />
                            <TextBlock x:Name="PreviewFileLabel" VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" MaxWidth="300" Visibility="Collapsed" />

                            <!-- Primary actions (icon-only compact buttons) -->
                            <Button x:Name="FullFileButton" Click="OnShowFullFile" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                    Padding="0" ToolTipService.ToolTip="Open the selected file in the full-file editor">
                                <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                            </Button>
                            <Button x:Name="CopyPreviewFilePathButton" Click="OnCopyPreviewFilePath" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                    Padding="0" ToolTipService.ToolTip="Copy the current preview file path">
                                <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                            </Button>
                            <Button x:Name="OpenInDefaultAppButton" Click="OnOpenInDefaultApp" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                    Padding="0" ToolTipService.ToolTip="Open the current file with the default app">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </Button>
                            <Button x:Name="OpenInEditorButton" Click="OnOpenInEditor" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                    Padding="0" ToolTipService.ToolTip="Open the current file in your configured external editor">
                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                            </Button>
                            <Button x:Name="ExpandAllSectionsButton" Click="OnExpandAllSections" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                    Padding="0" Visibility="Collapsed" ToolTipService.ToolTip="Expand all preview sections">
                                <FontIcon Glyph="&#xE740;" FontSize="12" />
                            </Button>
                            <Button x:Name="ExportReportButton" Click="OnExportHtmlReport" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                    Padding="0" ToolTipService.ToolTip="Export the current preview as a report">
                                <FontIcon Glyph="&#xE9F9;" FontSize="12" />
                            </Button>

                            <AppBarSeparator x:Name="PreviewToolbarSeparator" />

                            <!-- View options -->
                            <DropDownButton x:Name="LayoutDropDown" Content="Layout" VerticalAlignment="Center" FontSize="12"
                                            ToolTipService.ToolTip="Choose how selected files are laid out in the preview">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <ToggleMenuFlyoutItem x:Name="LayoutConcatenated" Text="Concatenated" Click="OnLayoutOptionClicked" />
                                        <ToggleMenuFlyoutItem x:Name="LayoutMultiHighlight" Text="Multi-highlight" Click="OnLayoutOptionClicked" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                            <Button x:Name="WordWrapDropDown" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                          Padding="0"
                                          ToolTipService.ToolTip="Choose word wrap mode for the preview and editor">
                                <FontIcon Glyph="&#xE8B3;" FontSize="12" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <ToggleMenuFlyoutItem x:Name="WrapModeWrap" Text="Word wrap" Click="OnWrapModeOptionClicked" />
                                        <ToggleMenuFlyoutItem x:Name="WrapModeNone" Text="No wrap" Click="OnWrapModeOptionClicked" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="FindReplaceButton" Click="OnOpenFindReplaceBar" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                    Padding="0" ToolTipService.ToolTip="Find or replace text in the preview/editor">
                                <FontIcon Glyph="&#xE721;" FontSize="12" />
                            </Button>
                            <StackPanel x:Name="PreviewContextPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Set how many context lines are shown around each preview match">
                                <TextBlock Text="Preview Context:" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                                <NumberBox Value="{x:Bind ViewModel.PreviewContextLines, Mode=TwoWay}" Minimum="0"
                                           SpinButtonPlacementMode="Compact" MinWidth="64" Width="64" FontSize="12"
                                           ToolTipService.ToolTip="Number of context lines shown around each match" />
                            </StackPanel>
                            <Button x:Name="ClearPreviewButton" Click="OnClearPreview" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                    Padding="0" ToolTipService.ToolTip="Clear the preview">
                                <FontIcon Glyph="&#xE894;" FontSize="12" />
                            </Button>

                        </StackPanel>
                        <StackPanel x:Name="MatchNavPanel" Grid.Column="1" Visibility="Collapsed"
                                    Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Border Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                                    BorderBrush="{ThemeResource SystemAccentColor}"
                                    BorderThickness="1" CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="MatchNavLabel" FontSize="11" Opacity="0.8"
                                               VerticalAlignment="Center" Margin="2,0"
                                               ToolTipService.ToolTip="Occurrences count every highlighted hit, including multiple hits on the same source line. The results list on the left is paged, so this occurrence may not be visible there until more rows are loaded." />
                                    <Button x:Name="PrevMatchButton" Click="OnPrevMatch"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="Previous occurrence">
                                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                    </Button>
                                    <Button x:Name="NextMatchButton" Click="OnNextMatch"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="Next occurrence">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button x:Name="ExpandPreviewButton" Grid.Column="2"
                                Click="OnExpandPreviewPanel"
                                Background="Transparent" BorderThickness="0"
                            Padding="6,4" VerticalAlignment="Center" Margin="6,0,0,0"
                                ToolTipService.ToolTip="Maximize preview / change preview layout">
                            <FontIcon x:Name="ExpandPreviewIcon" Glyph="&#xE740;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Grid x:Name="PreviewContentHost" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Find / Replace floating modal: overlays the preview/editor
                             content (does not push it down) and can be dragged by its grip.
                             Positioned below the preview toolbar so it does not cover the
                             drawer buttons. Opaque on open; dims to translucent when focus
                             leaves it (the close button stays more visible). -->
                        <Border x:Name="FindBar" Visibility="Collapsed" Grid.Row="1"
                                VerticalAlignment="Top" HorizontalAlignment="Right"
                                Canvas.ZIndex="60"
                                Margin="0,56,12,0"
                                Translation="0,0,32"
                                Background="Transparent"
                                BorderThickness="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="FindBarTranslate" />
                            </Border.RenderTransform>
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                            <Grid>
                                <!-- Opaque card-grey surface (matches the search card). This is the
                                     element whose opacity is reduced when the modal is inactive. -->
                                <Border x:Name="FindBarSurface"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="8" Padding="6,6,40,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4">
                                                <!-- Drag grip -->
                                                <Border x:Name="FindBarDragHandle"
                                                        PointerPressed="OnFindBarDragPointerPressed"
                                                        PointerMoved="OnFindBarDragPointerMoved"
                                                        PointerReleased="OnFindBarDragPointerReleased"
                                                        PointerCanceled="OnFindBarDragPointerReleased"
                                                        Background="Transparent" Width="16"
                                                        VerticalAlignment="Stretch"
                                                        ToolTipService.ToolTip="Drag to move">
                                                    <FontIcon Glyph="&#xE76F;" FontSize="12" Opacity="0.5" />
                                                </Border>
                                                <TextBox x:Name="FindTextBox" PlaceholderText="Find…" Width="220" FontSize="12"
                                                         KeyDown="OnFindTextBoxKeyDown" TextChanged="OnFindTextBoxTextChanged"
                                                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                                <Button Click="OnFindPrevious" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0">
                                                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                                </Button>
                                                <Button Click="OnFindNext" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0">
                                                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                                </Button>
                                                <CheckBox x:Name="FindMatchCaseCheckBox" Content="Aa" FontSize="11" MinWidth="0" Padding="4,0"
                                                          Unchecked="OnFindOptionChanged" Checked="OnFindOptionChanged" />
                                                <ToggleButton x:Name="FindReplaceToggle" Click="OnFindReplaceToggle" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0">
                                                    <FontIcon Glyph="&#xE8AC;" FontSize="12" />
                                                </ToggleButton>
                                                <TextBlock x:Name="FindStatusText" VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="4,0,0,0" />
                                            </StackPanel>
                                            <StackPanel x:Name="ReplaceRow" Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="20,4,0,0" Visibility="Collapsed">
                                                <TextBox x:Name="ReplaceTextBox" PlaceholderText="Replace…" Width="220" FontSize="12"
                                                         KeyDown="OnReplaceTextBoxKeyDown"
                                                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                                <Button x:Name="ReplaceOneButton" Click="OnReplaceOne" FontSize="12" Padding="8,4">
                                                    <TextBlock Text="Replace" />
                                                </Button>
                                                <Button x:Name="ReplaceAllButton" Click="OnReplaceAll" FontSize="12" Padding="8,4">
                                                    <TextBlock Text="All" />
                                                </Button>
                                                <Border Width="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="4,2" />
                                                <Button x:Name="ReplaceInFilesButton" Click="OnReplaceInAllFiles"
                                                        FontSize="12" Padding="8,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8AC;" FontSize="12" />
                                                        <TextBlock Text="All Files" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                                <!-- Close button overlays the top-right corner. It is a sibling of
                                     the surface so it can stay more opaque when the modal dims. -->
                                <Button x:Name="FindCloseButton" Click="OnCloseFindBar"
                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                        Margin="0,7,7,0" Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>

                        <ScrollViewer x:Name="PreviewScrollViewer" Grid.Row="1"
                                      HorizontalScrollMode="Enabled"
                                      HorizontalScrollBarVisibility="Visible"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid Margin="16,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Image preview thumbnail lives in its own row so it can sit above
                                     either the single-file block surface or the sections surface. OCR
                                     image previews show the picture above its recognized text. -->
                                <Border x:Name="PreviewImageThumbnailBorder" Grid.Row="0" Visibility="Collapsed"
                                        Margin="0,0,0,12" Padding="4" CornerRadius="4"
                                        BorderThickness="1" HorizontalAlignment="Left"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image x:Name="PreviewImageThumbnail" MaxHeight="320" MaxWidth="480"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel x:Name="PreviewMessagePanel" Grid.Row="1">
                                    <RichTextBlock x:Name="PreviewBlock" FontFamily="Consolas" TextWrapping="NoWrap" />
                                    <Button x:Name="PreviewBackButton" Visibility="Collapsed"
                                            Click="OnPreviewBackClick" Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                            <TextBlock Text="Back to preview" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel x:Name="PreviewSectionsPanel" Grid.Row="1" Visibility="Collapsed" Spacing="8" />
                                <StackPanel x:Name="PreviewLoadingPanel" Grid.Row="1" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                                            Margin="0,48,0,0">
                                    <ProgressRing x:Name="PreviewLoadingRing" IsActive="False" Width="36" Height="36" />
                                    <TextBlock x:Name="PreviewLoadingText" Text="Loading preview…"
                                               HorizontalAlignment="Center" Opacity="0.7" FontSize="13" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Grid x:Name="PreviewEmptyState" Grid.Row="1"
                              Visibility="Collapsed"
                              IsHitTestVisible="False"
                              Padding="24,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Canvas.ZIndex="5">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="640"
                                        Spacing="8">
                                        <FontIcon x:Name="PreviewEmptyStateIcon"
                                            Glyph="&#xE721;"
                                            FontSize="64"
                                            Margin="0,0,0,8"
                                            Opacity="0.8" />
                                <TextBlock Text="Nothing to show"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="Add files to this preview by selecting one or more files on the left panel, right clicking, and selecting the preview option."
                                           FontSize="13"
                                           Opacity="0.72"
                                           TextAlignment="Center"
                                           TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Grid>

                        <!-- Sticky horizontal scrollbar for multi-section preview mode.
                             The per-section ScrollViewers host horizontal scrolling but their
                             native scrollbars are anchored to the bottom of section content
                             (often thousands of pixels below the viewport). This overlay bar
                             is wired in code-behind to the currently-active section's scroller
                             so horizontal overflow is reachable without arrow-keying blindly. -->
                        <ScrollBar x:Name="StickyHorizontalScrollBar" Grid.Row="1"
                                   Orientation="Horizontal"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                   Margin="16,0,16,2"
                                   Visibility="Collapsed"
                                   Canvas.ZIndex="30"
                                   Scroll="OnStickyHorizontalScrollBarScroll" />

                        <!-- Sticky file header: shown when the actual file expander header
                             of the section currently in view has scrolled out the top.
                             Content is built dynamically from BuildPreviewSectionHeader so
                             it mirrors the per-file action buttons (Show full file, Copy
                             path, Open, Edit, Show in Explorer, Dismiss). -->
                        <Border x:Name="StickyFileHeader" Grid.Row="1" Visibility="Collapsed"
                                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource SystemAccentColor}"
                                BorderThickness="0,0,0,1"
                                Padding="12,6"
                                Tapped="StickyFileHeader_Tapped" />

                        <Canvas x:Name="ActiveMatchOverlay" Grid.Row="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Canvas.ZIndex="20"
                            IsHitTestVisible="False" Visibility="Collapsed">
                            <Border x:Name="ActiveMatchBand"
                                Canvas.ZIndex="20"
                                Height="18"
                                Background="#22FF6A00"
                                BorderBrush="#FFFF4500"
                                BorderThickness="1"
                                CornerRadius="3" />
                            <Border x:Name="ActiveMatchWordMarker"
                                Canvas.ZIndex="21"
                                Height="18"
                                MinWidth="12"
                                Background="#1AFF4500"
                                BorderBrush="#FFFF4500"
                                BorderThickness="0,0,0,2"
                                CornerRadius="2" />
                        </Canvas>

                        <Canvas x:Name="PreviewSelectionOverlay" Grid.Row="1"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Canvas.ZIndex="19"
                            IsHitTestVisible="False" />

                            <Canvas x:Name="PreviewShowMoreTooltipOverlay" Grid.Row="1"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Canvas.ZIndex="35"
                                IsHitTestVisible="True"
                                Visibility="Collapsed">
                                <Border x:Name="PreviewShowMoreTooltipBubble"
                                    Background="#B8181818"
                                    CornerRadius="4"
                                    Padding="7,4">
                                <StackPanel x:Name="PreviewShowMoreTooltipContent"
                                        Orientation="Horizontal"
                                        Spacing="6" />
                                </Border>
                            </Canvas>

                        <!-- Progress overlay for "Show all files" -->
                        <Grid x:Name="PreviewProgressOverlay" Grid.Row="1" Visibility="Collapsed">
                            <Border Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                                    Opacity="0.85" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <ProgressRing x:Name="PreviewProgressRing" IsActive="False" Width="40" Height="40" />
                                <TextBlock x:Name="PreviewProgressText" Text="Loading files…"
                                           HorizontalAlignment="Center" FontSize="14" />
                                <TextBlock x:Name="PreviewProgressPercent" Text="0%"
                                           HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <!-- Per-section match navigation overlay (file-level, stays visible during scroll) -->
                        <StackPanel x:Name="SectionNavOverlay" Grid.Row="1" Visibility="Collapsed"
                                    Orientation="Horizontal" Spacing="2"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,8,8" Opacity="0.75"
                                    PointerEntered="OnSectionNavPointerEntered"
                                    PointerExited="OnSectionNavPointerExited">
                            <Border Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                                    BorderBrush="{ThemeResource SystemAccentColor}"
                                    BorderThickness="1" CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock x:Name="SectionNavLabel" FontSize="11" Opacity="0.8"
                                               VerticalAlignment="Center" Margin="2,0"
                                               ToolTipService.ToolTip="Current occurrence and total matches in the active preview file." />
                                    <Button x:Name="SectionPrevButton" Click="OnSectionNavPrev"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="Previous occurrence in this file">
                                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                    </Button>
                                    <Button x:Name="SectionNavNextButton" Click="OnSectionNavNext"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="Next occurrence in this file">
                                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                    </Button>
                                    <Button Click="OnSectionNavDismiss"
                                            Width="24" Height="24" MinWidth="0" MinHeight="0" Padding="0"
                                            CornerRadius="4">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Grid x:Name="PreviewEditorContainer" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border x:Name="PreviewEditorPathBar" Grid.Row="0"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,7"
                                    MinHeight="50">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7C3;" FontSize="14" Opacity="0.8"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <Grid ColumnSpacing="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="PreviewEditorPathText" Grid.Column="0" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="PreviewEditorDirtyAsterisk" Grid.Column="1" Text="*"
                                                       Visibility="Collapsed" FontSize="16" FontWeight="Bold"
                                                       Foreground="#FFE6A100" VerticalAlignment="Center"
                                                       ToolTipService.ToolTip="Unsaved changes" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                                            <TextBlock x:Name="PreviewEditorChunkStatusText" Visibility="Collapsed"
                                                       FontSize="11" Opacity="0.65"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel x:Name="PreviewEditorChunkPanel" Visibility="Collapsed"
                                                        Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="LoadMorePreviewEditorChunkButton"
                                                        Click="OnLoadMorePreviewEditorChunk" FontSize="11" Padding="6,2"
                                                        ToolTipService.ToolTip="Load the next chunk of this large file into the editor">
                                                    <TextBlock Text="Load More" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="PreviewEditorToolbarPanel" Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <Button x:Name="EditorCopyPreviewFilePathButton" Click="OnCopyPreviewFilePath"
                                                Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                                ToolTipService.ToolTip="Copy the current editor file path">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        </Button>
                                        <Button x:Name="EditorWordWrapDropDown" Width="28" Height="28" MinWidth="0" MinHeight="0"
                                                      Padding="0"
                                                      ToolTipService.ToolTip="Choose word wrap mode for the editor">
                                            <FontIcon Glyph="&#xE8B3;" FontSize="12" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <ToggleMenuFlyoutItem x:Name="EditorWrapModeWrap" Text="Word wrap" Click="OnWrapModeOptionClicked" />
                                                    <ToggleMenuFlyoutItem x:Name="EditorWrapModeNone" Text="No wrap" Click="OnWrapModeOptionClicked" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button x:Name="EditorFindReplaceButton" Click="OnOpenFindReplaceBar"
                                                Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                                ToolTipService.ToolTip="Find or replace text in the editor">
                                            <FontIcon Glyph="&#xE721;" FontSize="12" />
                                        </Button>
                                        <Button x:Name="EditorPopOutButton" Click="OnPopOutPreviewEditor"
                                                Width="28" Height="28" MinWidth="0" MinHeight="0" Padding="0"
                                                ToolTipService.ToolTip="Pop the editor out into its own window">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel x:Name="EditorButtonsPanel" Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center" Visibility="Collapsed">
                                        <Button x:Name="SavePreviewEditButton" Click="OnSavePreviewEdit" FontSize="12" Padding="8,4"
                                                IsEnabled="False" ToolTipService.ToolTip="Save editor changes to the file">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                                <TextBlock Text="Save" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ClosePreviewEditButton" Click="OnClosePreviewEdit" FontSize="12" Padding="8,4"
                                                ToolTipService.ToolTip="Close the editor and return to preview">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                                <TextBlock Text="Back" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                        <Button x:Name="PreviewEditorExpandButton" Grid.Column="4"
                                            Click="OnExpandPreviewPanel"
                                            Background="Transparent" BorderThickness="0"
                                            Padding="6,4" VerticalAlignment="Center" Margin="2,0,0,0"
                                            ToolTipService.ToolTip="Maximize editor / change preview layout">
                                        <FontIcon x:Name="PreviewEditorExpandIcon" Glyph="&#xE740;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <tcb:TextControlBox x:Name="PreviewEditor" Visibility="Collapsed"
                                                    FontFamily="Consolas, Cascadia Mono, Segoe UI, Segoe UI Symbol, Segoe UI Emoji"
                                                    FontSize="13"
                                                    ShowLineNumbers="True"
                                                    ShowLineHighlighter="True"
                                                    EnableSyntaxHighlighting="False"
                                                    TextChanged="OnPreviewEditorTextChanged" />
                                <Border x:Name="PreviewEditorSavedOverlay"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,14,0,0"
                                        Padding="10,6"
                                        CornerRadius="6"
                                        Background="#CC181818"
                                        BorderBrush="#8022C55E"
                                        BorderThickness="1"
                                        Canvas.ZIndex="10">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8FB;" FontSize="14" Foreground="#FF22C55E" />
                                        <TextBlock Text="Saved" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- "Added to preview" snackbar: shown when files are previewed from the
                                     left panel while the editor is open (the preview surface is hidden behind
                                     the editor). "View in preview" closes the editor and scrolls the preview
                                     list to the last-added drawer. -->
                                <Border x:Name="PreviewAddedToast"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,24"
                                        Padding="14,10"
                                        CornerRadius="20"
                                        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Canvas.ZIndex="20"
                                        Translation="0,0,32">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7C3;" FontSize="14" Opacity="0.9" VerticalAlignment="Center" />
                                        <TextBlock x:Name="PreviewAddedToastText" Text="Added to preview"
                                                   FontSize="13" VerticalAlignment="Center" />
                                        <Button Click="OnPreviewAddedToastViewClick" Padding="10,4" CornerRadius="12"
                                                ToolTipService.ToolTip="Close the editor and jump to the added file in the preview list">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE890;" FontSize="12" />
                                                <TextBlock Text="View in preview" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OnPreviewAddedToastDismissClick" Width="28" Height="28"
                                                MinWidth="0" MinHeight="0" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="Dismiss">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom status bar -->
          <Grid x:Name="BottomStatusBar" Grid.Row="6" Padding="20,6,20,8"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="16">
            <Grid.Resources>
                <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="MaxLines" Value="1" />
                </Style>
                <Style x:Key="StatusBarMutedTextStyle" TargetType="TextBlock"
                       BasedOn="{StaticResource StatusBarTextStyle}">
                    <Setter Property="Opacity" Value="0.7" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" MinWidth="420" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.FilesPerSecondText, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.StatsForNerdsVisibility, Mode=OneWay}"
                     Style="{StaticResource StatusBarMutedTextStyle}" Opacity="0.6" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       Style="{StaticResource StatusBarTextStyle}" Opacity="0.8"
                       TextTrimming="CharacterEllipsis" />
            <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="16"
                Visibility="{x:Bind ViewModel.StatsForNerdsVisibility, Mode=OneWay}">
                <!-- Background utilization gauge -->
                <Rectangle x:Name="DiskGaugeBar" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                           Fill="CornflowerBlue" Opacity="0.18" Width="0" />
                <Polyline x:Name="ThroughputSparkline" Stroke="CornflowerBlue" StrokeThickness="1.2"
                          VerticalAlignment="Center" HorizontalAlignment="Stretch" Opacity="0.7" />
                <TextBlock x:Name="DiskGaugeLabel" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Style="{StaticResource StatusBarTextStyle}" Opacity="0.75" Margin="0,0,6,0" />
            </Grid>
            <!-- Right-aligned status cluster: resource usage, then the content-index status (+ a truncated
                 warning), then the skipped-count — in that order, flush to the right edge. Each item hides
                 independently, so the cluster adapts to whatever is present; the search stats stay far left
                 and the stretch column between keeps this group pinned to the right. -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- Yagu resource stats (disk temp + cached index storage + Yagu/worker RAM).
                     Measurement is off-thread; index size refreshes at most once per minute and never
                     while a search is active. Fixed columns prevent changing values from shifting
                     neighboring indicators; oversized values trim while their tooltips retain full detail. -->
                    <Grid x:Name="ResourceUsageStatusCluster" ColumnSpacing="12" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ResourceUsageStatusVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="104" />
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TempUsageBlock" Text="{x:Bind ViewModel.TempUsageText, Mode=OneWay}"
                               Style="{StaticResource StatusBarMutedTextStyle}"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Yagu temporary disk usage">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{x:Bind ViewModel.TempUsageTooltip, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360" />
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>
                          <TextBlock x:Name="IndexUsageBlock" Grid.Column="1"
                               Text="{x:Bind ViewModel.IndexUsageText, Mode=OneWay}"
                               Style="{StaticResource StatusBarMutedTextStyle}"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Yagu content index disk usage">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{x:Bind ViewModel.IndexUsageTooltip, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="400" />
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>
                          <TextBlock x:Name="RamUsageBlock" Grid.Column="2"
                               Text="{x:Bind ViewModel.RamUsageText, Mode=OneWay}"
                               Style="{StaticResource StatusBarMutedTextStyle}"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Yagu memory usage">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{x:Bind ViewModel.RamUsageTooltip, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="360" />
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </TextBlock>
                </Grid>
                <StackPanel x:Name="IndexStatusIndicator" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IndexStatusVisibility, Mode=OneWay}"
                            IsTabStop="True"
                            AutomationProperties.Name="Content index status"
                            AutomationProperties.HelpText="{x:Bind ViewModel.IndexStatusAccessibleHelpText, Mode=OneWay}"
                            Tapped="OnIndexStatusTapped"
                            ContextRequested="OnIndexStatusContextRequested"
                            KeyDown="OnIndexStatusKeyDown"
                            PointerEntered="OnIndexStatusPointerEntered"
                            PointerExited="OnIndexStatusPointerExited">
                    <!-- Keep a stable slot so changing status/percent text cannot move the neighboring
                        resource and Skipped labels. The content is left-anchored so different status
                        lengths do not visibly drift within the slot. -->
                    <Grid Width="230" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                 HorizontalAlignment="Left" VerticalAlignment="Center">
                            <!-- During index activity the native ProgressRing is compositor-animated;
                                 rotating a tiny rasterized FontIcon visibly pixel-snaps/hitches. -->
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <!-- Both glyph variants share one host so the build-spin ring swaps them as a unit. -->
                                <Grid x:Name="IndexStatusGlyphHost">
                                    <FontIcon x:Name="IndexStatusIcon"
                                        Glyph="{x:Bind ViewModel.IndexStatusGlyph, Mode=OneWay}"
                                        FontSize="12" Opacity="0.7"
                                        Visibility="{x:Bind ViewModel.IndexStatusNormalGlyphVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon x:Name="IndexStatusWarningIcon"
                                        Glyph="&#xE7BA;" FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Visibility="{x:Bind ViewModel.IndexStatusWarningVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressRing x:Name="IndexStatusProgressRing"
                                       Width="14" Height="14"
                                       IsActive="False" Visibility="Collapsed"
                                       Opacity="0.8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <!-- Sibling (not a reserved column) so a hidden check leaves no gap before the label. -->
                            <FontIcon x:Name="IndexHealthyCheckIcon"
                                  Glyph="&#xE930;" Foreground="LimeGreen"
                                  FontSize="12" VerticalAlignment="Center"
                                  Visibility="{x:Bind ViewModel.IndexHealthyCheckVisibility, Mode=OneWay}" />
                            <TextBlock x:Name="IndexStatusTextBlock"
                                     Text="{x:Bind ViewModel.IndexStatusText, Mode=OneWay}"
                                     MaxWidth="210" TextTrimming="CharacterEllipsis"
                                     Style="{StaticResource StatusBarMutedTextStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <TextBlock Foreground="DarkOrange" Style="{StaticResource StatusBarTextStyle}"
                           MaxWidth="190" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind ViewModel.Truncated, Mode=OneWay}"
                           Text="Results truncated — refine your query" />
                <TextBlock x:Name="SkipCountBlock" Width="88"
                           Style="{StaticResource StatusBarMutedTextStyle}" Opacity="0.6"
                           TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind ViewModel.SkippedCountVisibility, Mode=OneWay}"
                           Tapped="OnSkipCountTapped" PointerEntered="OnSkipCountPointerEntered"
                           PointerExited="OnSkipCountPointerExited">
                    <Run Text="Skipped: " />
                    <Run Text="{x:Bind ViewModel.FilesSkipped, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Index-status hover overlay. This deliberately matches the in-tree Skipped overlay below
             instead of using a Flyout/Popup. Live indexing updates the percentage and explanatory text
             frequently; keeping the surface in the main visual tree prevents WinUI from dismissing and
             recreating a separate popup as its placement target is remeasured. -->
        <Border x:Name="IndexStatusHoverOverlay"
                Grid.Row="4"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,8"
                MinWidth="320"
                MaxWidth="460"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Canvas.ZIndex="101"
                Translation="0,0,32"
                PointerEntered="OnIndexStatusHoverPanelPointerEntered"
                PointerExited="OnIndexStatusHoverPanelPointerExited">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel MaxWidth="420" Spacing="10">
                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IndexBuildPercentVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE895;" FontSize="18" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.IndexBuildPercentText, Mode=OneWay}"
                                   FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="complete" FontSize="13" Opacity="0.7"
                                   VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Width="220"
                                 Value="{x:Bind ViewModel.IndexBuildPercentValue, Mode=OneWay}"
                                 IsIndeterminate="True" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.IndexStatusTooltip, Mode=OneWay}"
                           TextWrapping="Wrap" FontSize="12" />
                <StackPanel x:Name="IndexStatusAutomaticIndexingPanel"
                           Spacing="5"
                           Visibility="Collapsed">
                   <TextBlock Text="Turn on automatic indexing"
                              FontSize="12"
                              FontWeight="SemiBold" />
                   <ComboBox x:Name="IndexStatusAutomaticIndexingComboBox"
                             HorizontalAlignment="Stretch"
                             MinWidth="280"
                             PlaceholderText="Choose when indexing should run"
                             AutomationProperties.Name="Automatic indexing schedule"
                             DropDownOpened="OnIndexStatusAutomaticIndexingDropDownOpened"
                             DropDownClosed="OnIndexStatusAutomaticIndexingDropDownClosed"
                             SelectionChanged="OnIndexStatusAutomaticIndexingSelectionChanged">
                       <ComboBoxItem Content="Continuously while Yagu is open (recommended)"
                                     Tag="Continuous" />
                       <ComboBoxItem Content="When the PC is idle"
                                     Tag="WhenIdle" />
                       <ComboBoxItem Content="At app startup"
                                     Tag="AtStartup" />
                       <ComboBoxItem Content="On the configured schedule"
                                     Tag="OnSchedule" />
                   </ComboBox>
                   <TextBlock Text="The choice is saved immediately. If updates are still manual-only, Yagu switches them to safe incremental updates so existing indexes stay current."
                              TextWrapping="Wrap"
                              FontSize="11"
                              Opacity="0.7" />
                </StackPanel>
                <StackPanel Spacing="4"
                       Visibility="{x:Bind ViewModel.AllDriveIndexStatusVisibility, Mode=OneWay}">
                    <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}"
                           Opacity="0.7" Margin="0,2,0,5" />
                    <TextBlock Text="All-drive and indexed-folder health"
                           FontSize="12" FontWeight="SemiBold" />
                    <ScrollViewer MaxHeight="280"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="IndexStatusAllDriveHealthRows" Spacing="8" />
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="IndexStatusRepairButton"
                            Visibility="Collapsed"
                            Click="OnIndexStatusRepairClick"
                            MinWidth="0" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock x:Name="IndexStatusRepairButtonText" Text="Rebuild index" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnIndexStatusOpenSettingsFromHoverClick"
                            MinWidth="0" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="12" />
                            <TextBlock Text="Indexing settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Skip breakdown overlay — floats above status bar, toggled by skip-count click -->
        <Border x:Name="SkipBreakdownOverlay"
                Grid.Row="4"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,8"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Canvas.ZIndex="100"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <TextBlock Text="{x:Bind ViewModel.SkipTooltip, Mode=OneWay}"
                       FontFamily="Consolas" FontSize="12"
                       IsTextSelectionEnabled="True" />
        </Border>

        <!-- Embedded terminal panel (ConPTY + xterm.js in WebView2) -->
        <Grid x:Name="TerminalHost" Grid.Row="5" Visibility="Collapsed" Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Vertical resize gripper -->
                <RowDefinition Height="Auto" />  <!-- Shell toolbar -->
                <RowDefinition Height="*" />     <!-- Terminal surface -->
            </Grid.RowDefinitions>

            <!-- Vertical resize gripper: drag up/down to change the terminal pane height. -->
            <Border x:Name="TerminalResizeGripper" Grid.Row="0" Height="10" Background="#252526" Opacity="0.6"
                    PointerPressed="OnTerminalResizePressed"
                    PointerMoved="OnTerminalResizeMoved"
                    PointerReleased="OnTerminalResizeReleased"
                    PointerEntered="OnTerminalResizePointerEntered"
                    PointerExited="OnTerminalResizePointerExited"
                    ToolTipService.ToolTip="Drag to resize the terminal">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3" Opacity="0.5">
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Thin toolbar: pick the shell (Command Prompt vs PowerShell) for the embedded terminal. -->
            <Grid Grid.Row="1" Background="#252526" Padding="8,3,8,3">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="Shell:" Foreground="#B8B8B8" FontSize="12" VerticalAlignment="Center" />
                    <ComboBox x:Name="TerminalShellSelector"
                              MinWidth="110"
                              FontSize="12"
                              SelectionChanged="OnTerminalShellSelectionChanged"
                              ToolTipService.ToolTip="Choose the shell used by the embedded terminal">
                        <ComboBoxItem Content="Cmd.exe" />
                        <ComboBoxItem Content="PowerShell" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <WebView2 x:Name="TerminalWebView" Grid.Row="2" DefaultBackgroundColor="#1E1E1E" IsTabStop="True" />
            <!-- Shown instead of a black WebView when the Microsoft Edge WebView2 Runtime is missing
                 (e.g. a clean Windows install/Sandbox). The embedded terminal is the only feature that
                 needs WebView2; the rest of Yagu works without it. The installer normally installs the
                 runtime, so this is a fallback for offline installs or machines that still lack it. -->
            <StackPanel x:Name="TerminalWebView2MissingPanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="440" Spacing="10" Padding="24">
                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE946;"
                          FontSize="26" Foreground="#CFCFCF" HorizontalAlignment="Center" />
                <TextBlock Text="The embedded terminal needs the Microsoft Edge WebView2 Runtime, which isn't installed on this machine."
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="#E4E4E4" />
                <HyperlinkButton Content="Get the WebView2 Runtime"
                                 NavigateUri="https://go.microsoft.com/fwlink/p/?LinkId=2124703"
                                 HorizontalAlignment="Center" />
                <TextBlock Text="After installing it, restart Yagu and reopen the terminal."
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="#9A9A9A" FontSize="12" />
            </StackPanel>
            <Button x:Name="TerminalChevron"
                    Grid.Row="2"
                    Click="OnToggleTerminalPane"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,32,10"
                    Width="36" Height="32" MinWidth="0" MinHeight="0"
                    Padding="0"
                    Background="#E6252526"
                    BorderBrush="#80454545"
                    BorderThickness="1"
                    CornerRadius="6"
                    Canvas.ZIndex="10"
                    ToolTipService.ToolTip="Toggle embedded terminal">
                <FontIcon x:Name="TerminalChevronIcon"
                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                          Glyph="&#xE70D;" FontSize="12" />
            </Button>
        </Grid>

        <TeachingTip x:Name="IntroTeachingTip"
                     IsOpen="False"
                     CloseButtonContent="Got it"
                     PreferredPlacement="Bottom"
                     ShouldConstrainToRootBounds="True"
                     MaxWidth="360"
                     Canvas.ZIndex="300" />

        <!-- Warning shown when the user tries to generate/send a CLI command with no search pattern.
             Target/placement are set in code: anchored to the search-pattern box (QueryBox).
             ShouldConstrainToRootBounds=False so it can overlay the open drawer flyout. -->
        <TeachingTip x:Name="CliCommandWarningTip"
                     IsOpen="False"
                     Title="Search pattern required"
                     CloseButtonContent="OK"
                     ShouldConstrainToRootBounds="False"
                     MaxWidth="360"
                     Canvas.ZIndex="300">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE7BA;" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </TeachingTip.IconSource>
        </TeachingTip>

        <!-- Full-content translucent overlay shown while a .yagu-session file is being saved or
             loaded. Mirrors the preview loading overlays (Acrylic + ProgressRing + percent) and
             covers the search card, status/progress row, split pane and terminal so the user can't
             mutate state mid-write; the custom title bar (row 0) stays usable. Driven by the shared
             session progress state (BeginSessionProgress/ReportSessionProgress/EndSessionProgress). -->
        <Grid x:Name="SessionBusyOverlay"
              Grid.Row="2" Grid.RowSpan="4"
              Canvas.ZIndex="250"
              Visibility="{x:Bind ViewModel.IsSessionBusy, Mode=OneWay}">
            <Border Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}" Opacity="0.85" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="560" Padding="24">
                <ProgressRing IsActive="{x:Bind ViewModel.IsSessionBusy, Mode=OneWay}" Width="40" Height="40" />
                <TextBlock Text="{x:Bind ViewModel.SessionProgressText, Mode=OneWay}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="14" />
                <TextBlock Text="{x:Bind ViewModel.SessionProgressPercentLabel, Mode=OneWay}"
                           HorizontalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- Full-content blocking overlay shown while the user triggers an on-demand index REBUILD from the
             status-bar indicator's "Index date … (click to rebuild)" menu. Unlike a normal background build,
             this deliberately blocks the rest of the UI (search card, results, split pane, terminal) until
             the rebuild finishes; the custom title bar (row 0) stays usable. Driven by the blocking-rebuild
             progress state (RebuildCurrentIndexBlockingAsync / ReportRebuildBlockingProgress). -->
        <Grid x:Name="IndexRebuildBusyOverlay"
              Grid.Row="2" Grid.RowSpan="4"
              Canvas.ZIndex="260"
              Visibility="{x:Bind ViewModel.IsIndexRebuildBlocking, Mode=OneWay}">
            <Border Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}" Opacity="0.9" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="600" Padding="28">
                <FontIcon Glyph="&#xE72C;" FontSize="28" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.IndexRebuildOverlayTitle, Mode=OneWay}"
                           HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
                <ProgressBar Minimum="0" Maximum="100"
                             Value="{x:Bind ViewModel.IndexRebuildProgressPercent, Mode=OneWay}"
                             IsIndeterminate="True"
                             Width="360" Height="6" />
                <TextBlock Text="{x:Bind ViewModel.IndexRebuildProgressText, Mode=OneWay}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="13" Opacity="0.9" />
                <TextBlock Text="{x:Bind ViewModel.IndexRebuildProgressPercentLabel, Mode=OneWay}"
                           HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="The rest of Yagu is paused until the rebuild finishes or cancellation completes."
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="12" Opacity="0.7" />
                <Button HorizontalAlignment="Center"
                        Padding="16,7"
                        IsEnabled="{x:Bind ViewModel.CanCancelIndexRebuild, Mode=OneWay}"
                        Click="OnCancelIndexRebuildClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.IndexRebuildCancelButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
