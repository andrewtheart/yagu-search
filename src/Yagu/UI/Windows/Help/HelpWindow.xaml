<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Yagu.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Yagu Help">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="12">

        <!-- Title-bar-less window (no OS caption): Escape closes it, matching the top-right close button. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnCloseAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
        </Grid.KeyboardAccelerators>

        <!--
          The navigation blade lives inside the rendered help document itself: pandoc is run with the
          table-of-contents option, and help-style.html turns that TOC into a collapsible left sidebar
          (sections revealing their subsections) that scroll-syncs with the content. So the window is
          a single full-width WebView; the app title is injected into the blade header at runtime.
        -->
        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <WebView2 x:Name="HelpWebView"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />

                <Grid x:Name="LoadingPanel"
                      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <ProgressRing IsActive="True"
                                      Width="32"
                                      Height="32" />
                        <TextBlock Text="Loading help..."
                                   Opacity="0.7" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="FallbackPanel"
                              Visibility="Collapsed"
                              Padding="24"
                              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Help could not be rendered in WebView2"
                                   FontWeight="SemiBold"
                                   FontSize="16"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="FallbackMessageText"
                                   TextWrapping="WrapWholeWords" />
                        <Border Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                Margin="0,8,0,8" />
                        <TextBlock x:Name="FallbackHelpText"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border x:Name="FindPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="12,8,48,0"
                Padding="8"
                Canvas.ZIndex="90"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="FindTextBox"
                         Grid.Column="0"
                         PlaceholderText="Find in help"
                         TextChanged="OnFindTextChanged"
                         KeyDown="OnFindTextBoxKeyDown" />

                <CheckBox x:Name="RegexCheckBox"
                          Grid.Column="1"
                          Content="Regex"
                          IsChecked="False"
                          VerticalAlignment="Center"
                          Checked="OnRegexOptionChanged"
                          Unchecked="OnRegexOptionChanged" />

                <TextBlock x:Name="MatchStatusText"
                           Grid.Column="2"
                           Text="No matches"
                           TextAlignment="Center"
                           VerticalAlignment="Center" />

                <Button x:Name="PreviousMatchButton"
                        Grid.Column="3"
                        Click="OnPreviousMatchClick"
                        IsEnabled="False"
                        Width="36"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        ToolTipService.ToolTip="Previous match">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>

                <Button x:Name="NextMatchButton"
                        Grid.Column="4"
                        Click="OnNextMatchClick"
                        IsEnabled="False"
                        Width="36"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        ToolTipService.ToolTip="Next match">
                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </Button>

                <Button Grid.Column="5"
                        Click="OnCloseFindClick"
                        Width="36"
                        Height="32"
                        MinWidth="0"
                        Padding="0"
                        ToolTipService.ToolTip="Close find">
                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                </Button>
            </Grid>
        </Border>

        <!-- Title-bar-less close affordance: floats in the top-right corner (no OS caption strip). -->
        <Button x:Name="CloseButton"
                Click="OnCloseClick"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="36"
                Height="32"
                MinWidth="0"
                Padding="0"
                Margin="0,-4,-4,0"
                Canvas.ZIndex="100"
                CornerRadius="4"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                ToolTipService.ToolTip="Close (Esc)">
            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Button>
    </Grid>
</Window>
